---
import type { CollectionEntry, InferEntrySchema } from "astro:content";
import Portrait from "./Portrait.astro";
import { URL_BASE } from "../consts";

interface Props {
  id: string;
  member: InferEntrySchema<"members">;
}
const { id, member } = Astro.props;

const memberHref = `${URL_BASE}/members/${id}`;
---

<article class="member-card" data-member aria-labelledby={`name-${id}`}>
  <Portrait href={memberHref} member={member} />
  <div class="member-copy">
    <div>
      <h3 id={`name-${id}`}>
        <a href={memberHref}>{member.name}</a>
      </h3>
      <p class="role">
        {member.role}
      </p>
      {
        member.type === "alumni" && (
          <p class="alumni-date">
            ({member.startDate?.getFullYear()}–{member.endDate?.getFullYear()})
          </p>
        )
      }
    </div>
    <!-- <p class="research">{member.research}</p> -->
    <a class="text-link" href={memberHref}>More info</a>
  </div>
</article>

<style>
  .member-card {
    min-width: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .member-card:has(a:not(.text-link):hover) a:not(.text-link) {
    text-decoration: underline 2px;
  }
  .member-copy {
    /* padding-top: 0.85rem; */
    /* display: grid;
    grid-template-columns: 1fr auto;
    align-items: center; */
    padding-block: 0.75rem 0.5rem;
    flex: 1;

    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  h3 {
    font-size: var(--fs-subheading);
    /* letter-spacing: -0.025em; */
    line-height: 1.3;
    margin: 0 0 0.2rem;

    & a {
      text-decoration: none;
      color: inherit;
    }
  }
  p {
    margin: 0;
  }
  .role {
    font-size: var(--fs-body);
  }
  .alumni-date {
    font-size: var(--fs-small);
    color: var(--clr-text-muted);
  }
  .text-link {
    display: block;
    font-size: var(--fs-small);
    margin-block-start: auto;
  }
  .research {
    /* color: var(--clr-text-muted); */
    font-size: var(--fs-body);
    line-height: 1.5;
    margin-top: 0.4rem;
    min-height: 2.6em;
  }
  .member-copy {
    border-bottom: 1px solid var(--clr-border-subtle);
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow {
      transition: none;
    }
  }
</style>
