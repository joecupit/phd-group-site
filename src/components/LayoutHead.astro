---
import type { ImageMetadata } from "astro";
import { SHORT_TITLE, LONG_TITLE, URL_BASE } from "../consts";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href=`${URL_BASE}/favicon.svg` />
<link rel="sitemap" href=`${URL_BASE}/sitemap-index.xml` />
<link
  rel="alternate"
  type="application/rss+xml"
  title={LONG_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link
  rel="preload"
  href=`${URL_BASE}/fonts/manrope-v20-latin-regular.woff2`
  as="font"
  type="font/woff"
  crossorigin
/>
<link
  rel="preload"
  href=`${URL_BASE}/fonts/manrope-v20-latin-500.woff2`
  as="font"
  type="font/woff"
  crossorigin
/>
<link
  rel="preload"
  href=`${URL_BASE}/fonts/manrope-v20-latin-600.woff2`
  as="font"
  type="font/woff"
  crossorigin
/>
<link
  rel="preload"
  href=`${URL_BASE}/fonts/manrope-v20-latin-700.woff2`
  as="font"
  type="font/woff"
  crossorigin
/>
<link
  rel="preload"
  href=`${URL_BASE}/fonts/manrope-v20-latin-800.woff2`
  as="font"
  type="font/woff"
  crossorigin
/>
<link
  rel="preload"
  href=`${URL_BASE}/fonts/sora-v17-latin-regular.woff2`
  as="font"
  type="font/woff"
  crossorigin
/>
<link
  rel="preload"
  href=`${URL_BASE}/fonts/sora-v17-latin-500.woff2`
  as="font"
  type="font/woff"
  crossorigin
/>
<link
  rel="preload"
  href=`${URL_BASE}/fonts/sora-v17-latin-600.woff2`
  as="font"
  type="font/woff"
  crossorigin
/>
<link
  rel="preload"
  href=`${URL_BASE}/fonts/sora-v17-latin-700.woff2`
  as="font"
  type="font/woff"
  crossorigin
/>
<link
  rel="preload"
  href=`${URL_BASE}/fonts/sora-v17-latin-800.woff2`
  as="font"
  type="font/woff"
  crossorigin
/>

<!-- Favicon -->
<link
  rel="icon"
  type="image/png"
  href=`${URL_BASE}/favicon-96x96.png`
  sizes="96x96"
/>
<link rel="icon" type="image/svg+xml" href=`${URL_BASE}/favicon.svg` />
<link rel="shortcut icon" href=`${URL_BASE}/favicon.ico` />
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href=`${URL_BASE}/apple-touch-icon.png`
/>
<meta name="apple-mobile-web-app-title" content="ICSE Research Group" />
<link rel="manifest" href=`${URL_BASE}/site.webmanifest` />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title ? `${title} | ${SHORT_TITLE}` : SHORT_TITLE}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(image.src, Astro.url)} />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
{
  image && (
    <meta property="twitter:image" content={new URL(image.src, Astro.url)} />
  )
}
