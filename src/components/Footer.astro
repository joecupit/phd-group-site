---
import {
  CONTACT_EMAIL,
  LONG_TITLE,
  SHORT_TITLE,
  UNIVERSITY_DEPARTMENT,
  UNIVERSITY_NAME,
  UNIVERSITY_URL,
  URL_BASE,
} from "../consts";
import { getCollection } from "astro:content";

interface FooterLink {
  label: string;
  href: string;
}
interface Props {
  department?: string;
  institution?: string;
  institutionHref?: string;
  email?: string;
  links?: FooterLink[];
  profileLinks?: FooterLink[];
}
const {
  department = UNIVERSITY_DEPARTMENT,
  institution = UNIVERSITY_NAME,
  institutionHref = UNIVERSITY_URL,
  email = CONTACT_EMAIL,
  links = [
    { label: "Research", href: `${URL_BASE}/research` },
    { label: "Publications", href: `${URL_BASE}/publications` },
    { label: "Members", href: `${URL_BASE}/members` },
    { label: "Contact", href: `${URL_BASE}/contact` },
  ],
  profileLinks = [],
  // profileLinks = [
  //   { label: "GitHub", href: "" },
  //   { label: "LinkedIn", href: "" },
  //   { label: "ORCID", href: "" },
  // ],
} = Astro.props;
const researchAreas = (await getCollection("research")).sort(
  (a, b) => a.data.pos - b.data.pos || a.data.title.localeCompare(b.data.title),
);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-main">
      <div class="group-info">
        <div>
          <p class="group-name">{SHORT_TITLE}</p>
          <p class="description">{LONG_TITLE}</p>
        </div>
        {
          (department || institution) && (
            <div class="institution">
              <p class="link-heading">Contact</p>
              <p>Dr Dongda Zhang</p>
              {department && <p>{department}</p>}
              {institution && <p>{institution}</p>}
              <p>
                <a class="email" href={`mailto:${email}`}>
                  {email}
                </a>
              </p>
            </div>
          )
        }
      </div>
      <div class="footer-links">
        <nav class="footer-navigation" aria-label="Footer navigation">
          <p class="link-heading">Quick links</p>
          <ul>
            {
              links.map(({ label, href }) => (
                <li>
                  <a href={href}>{label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        {
          researchAreas.length > 0 && (
            <nav class="research-navigation" aria-label="Research areas">
              <p class="link-heading">Research areas</p>
              <ul>
                {researchAreas.map((area) => (
                  <li>
                    <a href={`${URL_BASE}/research/${area.id}`}>
                      {area.data.shortTitle ?? area.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
    </div>
    <div class="footer-bottom">
      <p>© {SHORT_TITLE} {year}</p>
      <p>
        Website by <a href=`${URL_BASE}/members/joe-cupit`>Joe Cupit</a>.
      </p>
    </div>
  </div>
</footer>
<style>
  .site-footer {
    border-top: 1px solid var(--clr-border-subtle);
    /* background: var(--clr-emphasis-background); */
    color: var(--clr-primary-soft);
    background: var(--clr-dark-background);
  }
  .footer-inner {
    padding-block: 2.75rem 1.5rem;
  }
  .footer-main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 3rem;
    padding-bottom: 2.5rem;
  }
  .group-info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    /* flex: 2 1 340px; */
    /* flex: 1; */
  }
  .group-name {
    /* margin: 0 0 0.75rem; */
    /* color: var(--clr-text-strong); */
    color: var(--clr-text-inverse);
    font-size: var(--fs-heading);
    font-family: var(--ff-heading);
    font-weight: 800;
    line-height: 1;
  }
  .description {
    max-width: 48ch;
    margin: 0;
    /* line-height: 1.7; */
    font-size: var(--fs-subheading);
    /* color: var(--clr-text-muted); */
  }
  .institution {
    /* color: var(--clr-text-muted); */
    line-height: 1.8;
  }
  .footer-links {
    display: flex;
    /* flex-wrap: wrap; */
    justify-content: flex-end;
    gap: 4rem 5rem;
    /* flex: 1; */
    text-align: right;
  }
  .footer-navigation,
  .research-navigation {
  }
  .research-navigation a {
    line-height: 1.5;
    overflow-wrap: anywhere;
    text-wrap: nowrap;
  }
  .contact-links {
    /* color: var(--clr-text-muted); */
  }
  .contact-links-inner {
    display: flex;
    /* justify-content: space-between; */
  }
  ul {
    display: grid;
    gap: 0.65rem;
    list-style: none;
    margin-block-start: 0.5rem;
  }
  .contact-links ul {
    display: flex;
    gap: 0.75rem;
  }
  .link-heading {
    /* margin: 0 0 0.75rem; */
    font-weight: 800;
    /* color: var(--clr-text-strong); */
    color: var(--clr-text-inverse);
  }
  .email {
    display: inline-block;
    text-wrap: nowrap;
  }
  a {
    color: inherit;
    text-decoration: none;
    text-underline-offset: 4px;
  }
  a:hover {
    text-decoration: underline;
    /* color: var(--clr-primary-base); */
    /* font-weight: 500; */
  }
  a:focus-visible {
    outline: 2px solid var(--clr-primary-base);
    outline-offset: 4px;
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--clr-border-subtle);
  }
  .footer-bottom p {
    margin: 0;
    /* color: var(--clr-text-muted); */
    color: var(--clr-primary-soft);
    font-size: var(--fs-small);
    line-height: 1.6;
    opacity: 0.7;
  }
  .footer-bottom a {
    font-size: var(--fs-small);
  }
  @media (max-width: 750px) {
    .footer-main {
      grid-template-columns: 1fr;
    }
    .group-info {
      align-items: center;
      text-align: center;
    }
    .footer-links {
      justify-content: center;
      text-align: center;
    }
  }
  @media (max-width: 500px) {
    .footer-links {
      flex-direction: column;
      gap: 3rem;
    }
  }
</style>
