---
import { LONG_TITLE, SHORT_TITLE } from "../consts";
import { getCollection } from "astro:content";

interface FooterLink {
  label: string;
  href: string;
}
interface Props {
  groupName?: string;
  description?: string;
  institution?: string;
  institutionHref?: string;
  email?: string;
  links?: FooterLink[];
  profileLinks?: FooterLink[];
}
const {
  groupName = SHORT_TITLE,
  description = "Machine Learning for Chemical and Biochemical Systems.",
  institution = "The University of Manchester",
  institutionHref = "https://www.manchester.ac.uk/",
  email = "dongda.zhang@manchester.ac.uk",
  links = [
    { label: "Research", href: "/research/" },
    { label: "Publications", href: "/publications/" },
    { label: "Group", href: "/group/" },
    { label: "Contact", href: "/contact/" },
  ],
  profileLinks = [
    { label: "GitHub", href: "" },
    { label: "LinkedIn", href: "" },
    { label: "ORCID", href: "" },
  ],
} = Astro.props;
const researchAreas = (await getCollection("research")).sort(
  (a, b) => a.data.pos - b.data.pos || a.data.title.localeCompare(b.data.title),
);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-main">
      <div class="group-info">
        <p class="group-name">{groupName}</p>
        <p class="description">{LONG_TITLE}</p>
        {
          institution && (
            <p class="institution">
              {institutionHref ? (
                <a href={institutionHref}>{institution}</a>
              ) : (
                institution
              )}
            </p>
          )
        }
      </div>
      <nav class="footer-navigation" aria-label="Footer navigation">
        <p class="link-heading">Explore</p>
        <ul>
          {
            links.map(({ label, href }) => (
              <li>
                <a href={href}>{label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      {
        researchAreas.length > 0 && (
          <nav class="research-navigation" aria-label="Research areas">
            <p class="link-heading">Research areas</p>
            <ul>
              {researchAreas.map((area) => (
                <li>
                  <a href={`/research/${area.id}/`}>{area.data.title}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      {
        (email || profileLinks.length > 0) && (
          <div class="contact-links">
            <p class="contact-heading">Connect</p>
            {email && (
              <a class="email" href={`mailto:${email}`}>
                {email}
              </a>
            )}
            {profileLinks.length > 0 && (
              <ul aria-label="Group profiles">
                {profileLinks.map(({ label, href }) => (
                  <li>
                    <a href={href}>
                      {label} <span aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        )
      }
    </div>
    <div class="footer-bottom">
      <p>© {year} {groupName}</p>
      <p>
        A site by <a href="/group/joe-cupit">Joe Cupit</a>.
      </p>
    </div>
  </div>
</footer>
<style>
  .site-footer {
    border-top: 1px solid #dce5e2;
    background: #f4f7f4;
    color: #183b36;
  }
  .footer-inner {
    width: min(1180px, 100%);
    margin-inline: auto;
    padding: 2.75rem clamp(1rem, 4vw, 2.5rem) 1.25rem;
    box-sizing: border-box;
  }
  .footer-main {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 3rem;
    padding-bottom: 2.5rem;
  }
  .group-info {
    flex: 2 1 340px;
    min-width: 0;
  }
  .group-name {
    margin: 0 0 0.75rem;
    font-size: 1.1rem;
    font-weight: 650;
  }
  .description {
    max-width: 48ch;
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: #536760;
  }
  .institution {
    margin: 0.9rem 0 0;
    color: #536760;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .footer-navigation {
    flex: 1 1 120px;
  }
  .research-navigation {
    flex: 1.5 1 240px;
    min-width: 0;
  }
  .research-navigation a {
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .contact-links {
    flex: 1 1 200px;
    min-width: 0;
  }
  ul {
    display: grid;
    gap: 0.65rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .link-heading,
  .contact-heading {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .email {
    display: inline-block;
    margin-bottom: 0.9rem;
    overflow-wrap: anywhere;
  }
  a {
    color: #41685d;
    font-size: 0.9rem;
    text-decoration: none;
    text-underline-offset: 4px;
  }
  a:hover {
    text-decoration: underline;
  }
  a:focus-visible {
    outline: 2px solid #247568;
    outline-offset: 4px;
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid #dce5e2;
  }
  .footer-bottom p {
    margin: 0;
    color: #60756c;
    font-size: 0.8rem;
    line-height: 1.6;
  }
  .footer-bottom a {
    font-size: 0.8rem;
  }
  @media (max-width: 520px) {
    .footer-main {
      gap: 1.75rem;
    }
    .group-info {
      flex-basis: 100%;
    }
  }
</style>
