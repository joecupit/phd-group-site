---
import { getCollection } from "astro:content";

interface Props {
  filterAuthor?: string;
  year?: number;
  sortBy?: "date" | "title";
  limit?: number;
}

const { filterAuthor, year, sortBy = "date", limit } = Astro.props;

let items = await getCollection("publications");
if (year) {
  items = items.filter(
    (p) =>
      p.data.publicationDate &&
      new Date(p.data.publicationDate).getFullYear() == year,
  );
}
if (filterAuthor) {
  items = items.filter((p) => p.data.authors.includes(filterAuthor));
}
items = [...items].sort((a, b) => {
  if (sortBy === "title") {
    return a.data.title.localeCompare(b.data.title);
  }
  return (a.data.publicationDate ? new Date(a.data.publicationDate) : 0) <
    (b.data.publicationDate ? new Date(b.data.publicationDate) : 0)
    ? 1
    : -1;
});
if (limit) {
  items = items.slice(0, limit);
}

const people = await getCollection("group");
const peopleById = Object.fromEntries(people.map((p) => [p.id, p]));

const months = [
  "Jan",
  "Feb",
  "Mar",
  "Apr",
  "May",
  "Jun",
  "Jul",
  "Aug",
  "Sep",
  "Oct",
  "Nov",
  "Dec",
];
---

<ul class="publications">
  {
    items.length > 0
      ? items?.map((pub) => (
          <li>
            <p class="journal">
              {pub.data.publicationDate && (
                <span>{`${months[new Date(pub.data.publicationDate).getMonth()]} ${new Date(pub.data.publicationDate).getFullYear()}`}</span>
              )}
              · <span>{pub.data.journal}</span>
            </p>
            <a href={pub.data.doi} target="_blank">
              <h3 class="title">{pub.data.title}</h3>
            </a>
            <p class="authors">
              {pub.data.authors.map((author, index) => {
                const person = peopleById[author];

                if (person) {
                  const names = person.data.name.split(" ");
                  return (
                    <>
                      <a href={`/group/${person.id}`} class="group-author">
                        {`${names[0][0]}. ${names[names.length - 1]}`}
                      </a>
                      {index < pub.data.authors.length - 1 ? ", " : ""}
                    </>
                  );
                }

                const name = pub.data.authorNames?.[author] ?? author;
                const names = name.split(" ");
                return (
                  `${names[0][0]}. ${names[names.length - 1]}` +
                  (index < pub.data.authors.length - 1 ? ", " : "")
                );
              })}
            </p>
          </li>
        ))
      : "None"
  }
</ul>

<style>
  a {
    text-decoration: none;
    color: inherit;

    &:hover {
      color: var(--clr-primary);
    }
  }

  .publications {
    container-type: inline-size;

    list-style: none;

    display: grid;
    /* grid-template-columns: 9ch 1fr; */
    row-gap: 1rem;
    /* column-gap: 1ch; */
    width: 100%;

    & li {
      display: grid;
      gap: 0.25rem;
      background: white;
      border-radius: 0.5rem;
      padding-block: 1rem;
      padding-inline: 1.25rem;
    }

    & .title {
      font-family: var(--ff-heading);
      font-weight: 600;
      font-size: 1.1rem;
      max-width: 60ch;
      color: var(--clr-primary);
    }
    & .authors {
      /* margin-block-start: 0.5rem; */
      color: var(--clr-text-light);
      font-size: 0.9rem;
    }
    & .group-author {
      font-weight: 600;
      color: var(--clr-text);

      &:hover {
        color: var(--clr-primary);
      }
    }
    & .journal {
      display: flex;
      gap: 0.5rem;

      /* font-weight: 500; */
      font-size: 0.9rem;
      /* line-height: 1.2; */
      margin-block-start: 0.25rem;
      /* color: var(--clr-text-light); */
    }
  }

  @container (max-width: 34rem) {
    .publications li {
      grid-template-columns: 1fr;
      row-gap: 0.25lh;
    }
  }
</style>
