---
import { SHORT_TITLE, URL_BASE } from "../consts";
import LogoWide from "../assets/logo/LogoWide.astro";
import LogoShort from "../assets/logo/LogoShort.astro";
import LogoIcon from "../assets/logo/LogoIcon.astro";

interface NavLink {
  label: string;
  href: string;
}
interface Props {
  groupName?: string;
  homeHref?: string;
  links?: NavLink[];
  skipTo?: string;
}
const {
  groupName = SHORT_TITLE,
  homeHref = `${URL_BASE}/`,
  skipTo = "#main-content",
  links = [
    // { label: "Home", href: `${URL_BASE}/` },
    { label: "Research", href: `${URL_BASE}/research` },
    { label: "Publications", href: `${URL_BASE}/publications` },
    { label: "Members", href: `${URL_BASE}/members` },
    { label: "Get in touch", href: `${URL_BASE}/contact`, style: "button" },
  ],
} = Astro.props;
const normalise = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalise(Astro.url.pathname);
const activeFor = (href: string) => {
  const target = new URL(href, Astro.url);
  if (target.origin !== Astro.url.origin) return false;
  const path = normalise(target.pathname);
  return (
    currentPath === path ||
    (path !== `${URL_BASE}/` && currentPath.startsWith(`${path}/`))
  );
};
---

<header class="site-header">
  <a class="skip-link" href={skipTo}>Skip to content</a>
  <group-navigation class="navigation" data-open="false">
    <a class="brand" href={homeHref}>
      <!-- {groupName} -->
      <LogoWide />
      <!-- <LogoShort /> -->
      <!-- <LogoIcon /> -->
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-navigation"
      hidden
    >
      <span>Menu</span>
      <span class="menu-icon" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>
    <nav id="site-navigation" class="nav-links" aria-label="Main navigation">
      {
        links.map(({ label, href, style }) => (
          <a
            href={href}
            class={style === "button" ? "nav-button" : ""}
            aria-current={activeFor(href) ? "page" : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>
  </group-navigation>
</header>

<script>
  class GroupNavigation extends HTMLElement {
    private controller?: AbortController;
    connectedCallback() {
      this.controller?.abort();
      const controller = new AbortController();
      this.controller = controller;
      const button = this.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = this.querySelector<HTMLElement>("nav");
      if (!button || !nav) return;
      const mobile = window.matchMedia("(max-width: 760px)");
      const setOpen = (open: boolean) => {
        this.dataset.open = String(open);
        button.setAttribute("aria-expanded", String(open));
      };
      setOpen(false);
      this.dataset.enhanced = "true";
      button.hidden = false;
      button.addEventListener(
        "click",
        () => setOpen(this.dataset.open !== "true"),
        { signal: controller.signal },
      );
      this.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Escape" && this.dataset.open === "true") {
            setOpen(false);
            button.focus();
          }
        },
        { signal: controller.signal },
      );
      nav.addEventListener(
        "click",
        (event) => {
          if (event.target instanceof Element && event.target.closest("a"))
            setOpen(false);
        },
        { signal: controller.signal },
      );
      mobile.addEventListener("change", () => setOpen(false), {
        signal: controller.signal,
      });
    }
    disconnectedCallback() {
      this.controller?.abort();
    }
  }
  if (!customElements.get("group-navigation"))
    customElements.define("group-navigation", GroupNavigation);
</script>

<style>
  .site-header {
    /* --_clr-navbar-background: var(--clr-page-background);
    --_clr-navbar-logo-text: var(--clr-text-strong);
    --_clr-navbar-logo-primary: var(--clr-primary-base);
    --_clr-navbar-logo-accent: var(--clr-accent); */
    /* position: relative; */
    --_clr-navbar-background: var(--clr-page-background);
    /* --_clr-navbar-background: var(--clr-dark-background); */
    /* --_clr-navbar-background: transparent; */
    --clr-logo-background: var(--_clr-navbar-background);
    /* --clr-logo-text: var(--clr-text-inverse); */

    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--clr-border-subtle);
    /* border-bottom: 1px solid hsl(from var(--clr-dark-background) h s 30%); */
    background: var(--_clr-navbar-background);
    /* color: var(--clr-text-inverse);
    background: var(--clr-dark-background); */
  }
  .navigation {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    margin-inline: auto;
    padding-block: 0.75rem;
  }
  .navigation a {
    color: var(--clr-text-strong);

    /* &:hover {
      color: var(--clr-text-strong);
    } */
  }
  .brand {
    height: 2.75rem;
    /* color: var(--clr-text-inverse); */
    font-size: var(--fs-subheading);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.35;
    text-decoration: none;
    overflow-wrap: anywhere;

    & :global(svg) {
    }
  }
  .nav-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.35rem 1.3rem;
    /* font-size: var(--fs-small); */
  }
  .nav-links a {
    padding: 0.4rem 0;
    /* color: var(--clr-text-inverse); */
    text-decoration: none;
    text-underline-offset: 6px;
    white-space: nowrap;
  }
  .nav-links a:hover,
  .nav-links a[aria-current="page"] {
    /* color: var(--clr-text-body); */
    text-decoration: underline;
  }
  .nav-links a[aria-current="page"] {
    font-weight: 600;
  }
  .nav-links a.nav-button {
    color: var(--clr-primary-soft);
    background: var(--clr-primary-base);
    font-weight: 600;
    padding-inline: 1.25ch;
    border-radius: 0.25rem;

    transition-property: color, background-color;
    transition-duration: 100ms;
    transition-timing-function: ease-in-out;

    &:hover {
      text-decoration: none;
      background: var(--clr-primary-hover);
    }
  }
  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.7rem;
    background: transparent;
    border: 1px solid var(--clr-border-strong);
    border-radius: 5px;
    /* color: var(--clr-text-body); */
    font: inherit;
    cursor: pointer;
  }
  .menu-icon {
    display: grid;
    gap: 5px;
    width: 16px;
  }
  .menu-icon span {
    display: block;
    height: 1px;
    background: currentColor;
  }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--clr-primary-base);
    outline-offset: 4px;
  }
  .skip-link {
    position: absolute;
    top: 0.5rem;
    left: 1rem;
    z-index: 10;
    transform: translateY(-200%);
    padding: 0.65rem 1rem;
    background: var(--clr-primary-base);
    /* color: var(--clr-page-background); */
    border-radius: 4px;
  }
  .skip-link:focus {
    transform: translateY(0);
  }
  @media (max-width: 760px) {
    .navigation {
      flex-wrap: wrap;
      gap: 1rem;
    }
    .nav-links {
      flex: 0 0 100%;
      justify-content: flex-start;
      gap: 0.3rem 1.3rem;
      padding-top: 0.3rem;
    }
    .navigation[data-enhanced="true"] .menu-toggle {
      display: inline-flex;
    }
    .navigation[data-enhanced="true"][data-open="false"] .nav-links {
      display: none;
    }
    .navigation[data-enhanced="true"][data-open="true"] .nav-links {
      display: flex;
    }
  }
  [hidden] {
    display: none !important;
  }
</style>
