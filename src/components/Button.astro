---
import ArrowRightIcon from "../assets/icons/ArrowRightIcon.astro";

interface Props {
  href: string;
  fill?: "empty" | "solid";
  size?: "big" | "small";
  color?: "white";
  icon?: "arrow";
}
const { href, fill, size, color, icon } = Astro.props as Props;
---

<a href={href} class={"button" + (fill ? ` ${fill}` : "") + (size ? ` ${size}` : "") + (color ? ` ${color}` : "")}>
    <slot />
    {icon === "arrow" ? <ArrowRightIcon /> : <></>}
</a>

<style is:global>
    .button {
        display: flex;
        gap: 1ch;
        align-items: center;
        justify-content: center;
        text-align: center;

        padding-inline: 2ch 1.5ch;
        padding-block: 0.5ch;
        height: fit-content;
        cursor: pointer;

        font-family: var(--ff-body);
        font-size: var(--fs-body);
        font-weight: 600;
        text-decoration: none;

        background: none;
        color: var(--clr-primary-base);
        border: 2px solid var(--clr-primary-base);
        /* color: var(--clr-secondary-base);
        border: 2px solid var(--clr-secondary-base); */

        transition-property: color, background-color;
        transition-duration: 100ms;
        transition-timing-function: ease-in-out;

        & svg {
            width: 1.5ch;
            height: 1.5ch;
        }
        &:hover {
            color: var(--clr-page-background);
            background: var(--clr-primary-base);
        }
    }

    /* fills */
    .button.solid {
        color: var(--clr-page-background);
        background: var(--clr-primary-base);
        /* background: var(--clr-secondary-base); */

        &:hover {
            background: var(--clr-primary-hover);
            /* border-color: var(--clr-primary-hover); */
            /* background: var(--clr-secondary-hover);
            border-color: var(--clr-secondary-hover); */
        }
    }

    /* sizes */
    .button.small {
        font-size: var(--fs-small);
    }
    .button.big {
        font-size: var(--fs-subheading);
    }

    /* colours */
    .button.white {
    background: var(--clr-dark-background);
    border-color: var(--clr-text-inverse);
    color: var(--clr-text-inverse);

    &:hover {
      color: var(--clr-dark-background);
      background: var(--clr-text-inverse);
    }
    }
</style>
