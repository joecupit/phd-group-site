---
import ArrowRightIcon from "../assets/icons/ArrowRightIcon.astro";

interface Props {
  href: string;
  fill?: "empty" | "solid";
  size?: "big" | "small";
  color?: "white";
  icon?: "arrow";
}
const { href, fill, size, color, icon } = Astro.props as Props;
---

<a href={href} class={"button" + (fill ? ` ${fill}` : "") + (size ? ` ${size}` : "") + (color ? ` ${color}` : "")}>
    <slot />
    {icon === "arrow" ? <ArrowRightIcon /> : <></>}
</a>

<style is:global>
    .button {
        display: flex;
        gap: 1ch;
        align-items: center;
        text-align: center;

        padding-inline: 2ch 1.5ch;
        padding-block: 0.5ch;
        height: fit-content;

        font-family: var(--ff-body);
        font-size: var(--fs-body);
        font-weight: 600;
        text-decoration: none;

        background: none;
        color: var(--clr-primary);
        border: 2px solid var(--clr-primary);

        transition-property: color, background-color;
        transition-duration: 100ms;
        transition-timing-function: ease-in-out;

        & svg {
            width: 1.5ch;
            height: 1.5ch;
        }
        &:hover {
            color: var(--clr-bg);
            background: var(--clr-primary);
        }
    }

    /* fills */
    .button.solid {
        color: var(--clr-bg);
        background: var(--clr-primary);

        &:hover {
            background: var(--clr-primary-dark);
            border-color: var(--clr-primary-dark);
        }
    }

    /* sizes */
    .button.small {
        font-size: var(--fs-small);
    }
    .button.big {
        font-size: var(--fs-subheading);
    }

    /* colours */
    .button.white {
        color: var(--clr-bg);
        border-color: var(--clr-bg);

        &:hover {
            color: var(--clr-primary);
            background-color: var(--clr-bg);
        }
    }
</style>
