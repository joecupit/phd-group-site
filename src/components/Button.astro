---
import ArrowIcon from "../assets/icons/ArrowIcon.astro";

interface Props {
  href: string;
  size?: "big" | "small";
  color?: "white";
  icon?: "arrow";
}
const { href, size, color, icon } = Astro.props as Props;
---

<a href={href} class={"button" + (size ? ` ${size}` : "") + (color ? ` ${color}` : "")}>
    <slot />
    {icon === "arrow" ? <ArrowIcon /> : <></>}
</a>

<style is:global>
    .button {
        display: flex;
        gap: 1ch;
        align-items: center;

        padding-inline: 2ch 1.5ch;
        padding-block: 0.5ch;
        height: fit-content;

        font-family: var(--ff-body);
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;

        background: none;
        color: var(--clr-primary);
        border: 2px solid var(--clr-primary);

        transition: all 100ms ease-in-out;

        & svg {
            width: 1.5ch;
            height: 1.5ch;
        }
        &:hover {
            color: var(--clr-bg);
            background: var(--clr-primary);
        }
    }

    /* sizes */
    .button.big {
        font-size: 1.125rem;
    }

    /* colours */
    .button.white {
        color: var(--clr-bg);
        border-color: var(--clr-bg);

        &:hover {
            color: var(--clr-primary);
            background-color: var(--clr-bg);
        }
    }
</style>
