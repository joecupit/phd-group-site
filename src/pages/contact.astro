---
import {
  CONTACT_EMAIL,
  UNIVERSITY_DEPARTMENT,
  UNIVERSITY_NAME,
} from "../consts";
import Layout from "../layouts/Layout.astro";

// Replace these placeholders with the group supervisor's details.
const contact = {
  name: "Dr Dongda Zhang",
  email: CONTACT_EMAIL,
  department: UNIVERSITY_DEPARTMENT,
  university: UNIVERSITY_NAME,
};
---

<Layout title="Contact">
  <section id="main-content">
    <div class="contact-page">
      <div>
        <h1>Get in touch</h1>
        <p class="intro">For enquiries about the group and our research.</p>
      </div>
      <div class="contact-details" aria-labelledby="supervisor-name">
        <!-- <p class="role">Group supervisor</p> -->
        <h2 id="supervisor-name">{contact.name}</h2>
        <address>
          <p class="affiliation">
            {contact.department}<br />
            {contact.university}
          </p>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </address>
      </div>
    </div>
  </section>
</Layout>

<style>
  section {
    padding-block: 3.5rem;
  }
  .contact-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  h1 {
    font-size: var(--fs-heading);
    font-family: var(--ff-heading);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }
  .intro {
    /* font-size: var(--fs-subheading); */
    /* line-height: 1.6; */
    max-width: 50ch;
    margin-block-start: 0.5rem;
  }

  .contact-details {
    /* margin-top: 2.5rem; */
    /* padding-top: 2rem; */
    background: var(--clr-card-background);
    border-inline-start: 5px solid var(--clr-primary-base);
    padding-inline: 1.5rem 3rem;
    padding-block: 0.5rem;
    width: fit-content;
  }

  .role {
    color: var(--clr-text-muted);
    /* font-size: var(--fs-small); */
    font-weight: 600;
    /* letter-spacing: 0.1em;
    text-transform: uppercase; */
  }

  address {
    font-style: normal;
  }

  h2 {
    font-size: var(--fs-body);
    /* font-family: var(--ff-heading); */
    font-weight: 600;
  }

  a {
    color: var(--clr-primary-base);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  a:hover {
    text-decoration-thickness: 2px;
    color: var(--clr-primary-hover);
  }
  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
</style>
