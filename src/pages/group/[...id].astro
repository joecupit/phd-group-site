---
import { getCollection, render, type CollectionEntry } from "astro:content";
import MemberLayout from "../../layouts/MemberLayout.astro";
export async function getStaticPaths() {
  return (await getCollection("group")).map((member) => ({
    params: { id: member.id },
    props: { member },
  }));
}
interface Props {
  member: CollectionEntry<"group">;
}
const { member } = Astro.props;
const { Content } = await render(member);
---

<MemberLayout member={member}><Content /></MemberLayout>
