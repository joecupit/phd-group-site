                  {/* <div class="card-topline">
                    <span class="card-index" aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <span class="card-arrow" aria-hidden="true">
                      <ArrowUpRightIcon />
                    </span>
                  </div> */}
                  <div>
                    <div class="research-card-header">
                      <h3 id={`area-heading-${index}`}>
                        <a href={researchHref(area.id)}>{area.data.title}</a>
                      </h3>
                      <div class="research-card-header-icon">
                        <Icon />
                      </div>
                    </div>
                    <p>{area.data.summary}</p>
                  </div>
                  <a
                    class="card-link"
                    href={researchHref(area.id)}
                    aria-hidden="true"
                  >
                    Find out more
                  </a>
                  {/* </div> */}
                </div>
              );
            })}
            {/* {researchAreas.map((area, index) => (
              <a
                class="research-card"
                href={researchHref(area.id)}
                aria-labelledby={`area-heading-${index}`}
              >
                {area.data.coverImage && (
                  <img
                    class="research-image"
                    src={area.data.coverImage.src}
                    width={area.data.coverImage.width}
                    height={area.data.coverImage.height}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="research-card-inner">
                  <div class="card-topline">
                    <span class="card-index" aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <span class="card-arrow" aria-hidden="true">
                      <ArrowUpRightIcon />
                    </span>
                  </div>
                  <div>
                    <h3 id={`area-heading-${index}`}>{area.data.title}</h3>
                    <p>{area.data.subtitle}</p>
                  </div>
                  <span class="card-link" aria-hidden="true">
                    Find out more
                  </span>
                </div>
              </a>
            ))} */}
          </div>
        </section>
      )
    }

    <!-- {
      featuredResearch.length > 0 && (
        <section class="featured-section" aria-labelledby="featured-heading">
          <div class="section-top">
            <div>
              <p class="eyebrow">From methods to applications</p>
              <h2 id="featured-heading">Research in focus</h2>
            </div>
          </div>
          <div class="feature-grid">
            {featuredResearch.map((feature, index) => (
              <article
                class:list={[
                  "feature-card",
                  { "feature-card--dark": index % 2 === 0 },
                ]}
              >
                {feature.image && (
                  <img
                    src={feature.image.src}
                    alt={feature.image.alt}
                    width="720"
                    height="400"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="feature-copy">
                  <p class="feature-category">{feature.category}</p>
                  <h3>{feature.title}</h3>
                  <p class="feature-description">{feature.description}</p>
