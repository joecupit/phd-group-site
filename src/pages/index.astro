---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { LONG_TITLE, URL_BASE } from "../consts";
import PublicationList from "../components/PublicationList.astro";
import Button from "../components/Button.astro";
import ArrowRightIcon from "../assets/icons/ArrowRightIcon.astro";
import ArrowUpRightIcon from "../assets/icons/ArrowUpRightIcon.astro";

const site = {
  groupName: LONG_TITLE, // Replace with your agreed group name.
  groupHref: `${URL_BASE}/members`,
  publicationsHref: `${URL_BASE}/publications`,
  contactHref: `${URL_BASE}/contact`,
};

// Optional: a laboratory, group or research image from your public/ directory.
const media: { hero?: { src: string; alt: string } } = {
  // hero: { src: `${URL_BASE}/research.webp", alt: "[Describe the research shown]" },
};
const heroImage = media.hero;

interface Partner {
  name: string;
  logo: string; // Public asset URL, e.g. /images/partners/company.svg
  href?: string;
}
// Add confirmed collaborators and their approved logos. Empty = section hidden.
const partners: Partner[] = [
  {
    name: "Unilever",
    logo: `${URL_BASE}/images/logos/unilever.svg`,
  },
  {
    name: "BP",
    logo: `${URL_BASE}/images/logos/bp.png`,
  },
  {
    name: "Croda",
    logo: `${URL_BASE}/images/logos/croda.png`,
  },
  {
    name: "Johnson Matthey",
    logo: `${URL_BASE}/images/logos/johnson-matthey.svg`,
  },
  {
    name: "Keit Industrial Analytics",
    logo: `${URL_BASE}/images/logos/keit-industrial-analytics.png`,
  },
  {
    name: "Applied Materials",
    logo: `${URL_BASE}/images/logos/applied-materials.png`,
  },
  {
    name: "CPACT",
    logo: `${URL_BASE}/images/logos/cpact.png`,
  },
  {
    name: "CPACT",
    logo: `${URL_BASE}/images/logos/cpact.png`,
  },
];

interface Feature {
  category: string;
  title: string;
  description: string;
  href: string;
  image?: { src: string; alt: string };
}
// These are research examples, rather than claims about active project status.
// Replace or expand them with your group's chosen projects and images.
const featuredResearch: Feature[] = [
  {
    category: "Bioprocess engineering",
    title: "Predicting performance across scales",
    description:
      "How can laboratory and pilot-scale data help predict industrial fermentation? We investigate hybrid models that combine process knowledge with data and adapt between scales.",
    href: `${URL_BASE}/research/bioprocess-engineering/`,
  },
  {
    category: "Industrial analytics",
    title: "Making operational data useful",
    description:
      "Industrial sensor histories contain information about quality and equipment condition. We develop soft sensors and predictive-maintenance methods that make use of these records, including trajectories with missing failure labels.",
    href: `${URL_BASE}/research/industrial-analytics/`,
  },
];

const researchAreas = (await getCollection("research")).sort(
  (a, b) => a.data.pos - b.data.pos || a.data.title.localeCompare(b.data.title),
);
const researchHref = (id: string) => `${URL_BASE}/research/${id}`;
---

<Layout>
  <div class="page-grid" id="main-content">
    <section>
      <div class="hero">
        <div class="hero-copy">
          <!-- <p class="eyebrow">
            <span class="status-dot" aria-hidden="true"></span>{site.groupName}
          </p> -->
          <!-- <h1>Intelligent models for <em>complex processes.</em></h1> -->
          <h1>{site.groupName + " Research Group"}</h1>
          <p class="hero-description">
            Integrating <em>domain knowledge</em> and <em>data intelligence</em> for
            digital transformation of chemical and biochemical processes
          </p>
          <div class="button-row">
            <Button href=`${URL_BASE}/research` fill="solid">
              Explore our research <ArrowRightIcon />
            </Button>
            <Button href=`${URL_BASE}/members`>Meet the group</Button>
          </div>
        </div>
        <!-- <div
          class:list={[
            "hero-visual",
            { "hero-visual--photo": Boolean(heroImage) },
          ]}
        >
          {
            heroImage ? (
              <img
                src={heroImage.src}
                alt={heroImage.alt}
                width="720"
                height="840"
                fetchpriority="high"
              />
            ) : (
              <>
                <p class="visual-heading">Knowledge. Data. Decisions.</p>
                <svg
                  class="hero-network"
                  viewBox="0 0 400 380"
                  aria-hidden="true"
                  focusable="false"
                >
                  <g fill="none" stroke="currentColor">
                    <circle class="orbit" cx="200" cy="190" r="144" />
                    <circle
                      class="orbit orbit--inner"
                      cx="200"
                      cy="190"
                      r="94"
                    />
                    <path
                      class="network-lines"
                      d="M62 143 151 63 294 104 339 244 239 321 107 283 62 143M151 63 200 190 294 104M62 143 200 190 339 244M107 283 200 190 239 321M151 63 294 104 239 321 107 283 151 63"
                    />
                  </g>
                  <g class="network-nodes">
                    <>
                      <circle cx="62" cy="143" r="7" />
                      <circle cx="151" cy="63" r="7" />
                    </>
                    <>
                      <circle cx="294" cy="104" r="7" />
                      <circle cx="339" cy="244" r="7" />
                    </>
                    <>
                      <circle cx="239" cy="321" r="7" />
                      <circle cx="107" cy="283" r="7" />
                    </>
                    <circle class="network-centre" cx="200" cy="190" r="14" />
                  </g>
                </svg>
                <div class="visual-labels">
                  <span>Physical understanding</span>
                  <span>Machine intelligence</span>
                  <span>Engineering decisions</span>
                </div>
              </>
            )
          }
        </div> -->
      </div>
    </section>

    <section aria-labelledby="introduction-heading">
      <div class="introduction">
        <div class="introduction-photo">
          <!-- <h2 id="introduction-heading">
            Connecting scientific understanding with engineering decisions.
            Chemical engineering, machine learning, sustainable manufacturing.
          </h2> -->
          (group photo)
        </div>
        <div class="introduction-copy">
          <p>
            We are an interdisciplinary research group working at the interface
            of chemical engineering, sustainable manufacturing, and machine
            learning.
          </p>
          <p>
            We develop interpretable, data-driven, and hybrid digital twins that
            integrate domain knowledge with AI to accelerate materials design,
            reaction understanding, process development, real-time optimisation,
            and autonomous operation, enabling robust and circular manufacturing
            solutions in close partnership with industry across formulation,
            specialty chemicals, and biopharmaceuticals.
          </p>
          <!-- <p>
            Chemical and biological systems are complex, and the data available
            to describe them are often incomplete. We develop methods that bring
            engineering knowledge and machine learning together to build useful
            models under these conditions.
          </p>
          <p>
            Our research spans molecules, reactions, cells and manufacturing
            processes. Across these scales, we connect prediction with
            interpretation, design and operation.
          </p> -->
        </div>
      </div>
    </section>

    {
      researchAreas.length > 0 && (
        <section
          class="research-section"
          id="research"
          aria-labelledby="research-heading"
        >
          <div class="section-top">
            <div>
              <h2 id="research-heading">Research areas</h2>
              <p class="section-intro">
                Working at the interface of chemical engineering, sustainable
                manufacturing, and machine learning
              </p>
            </div>
            <Button href={`${URL_BASE}/research`} size="small">
              Explore our research <ArrowRightIcon />
            </Button>
          </div>
          <div class="research-grid">
            {researchAreas.map((area, index) => (
              <a
                class="research-card"
                href={researchHref(area.id)}
                aria-labelledby={`area-heading-${index}`}
              >
                {area.data.coverImage && (
                  <img
                    class="research-image"
                    src={area.data.coverImage.src}
                    width={area.data.coverImage.width}
                    height={area.data.coverImage.height}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="research-card-inner">
                  <div class="card-topline">
                    <span class="card-index" aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <span class="card-arrow" aria-hidden="true">
                      <ArrowUpRightIcon />
                    </span>
                  </div>
                  <div>
                    <h3 id={`area-heading-${index}`}>{area.data.title}</h3>
                    <p>{area.data.subtitle}</p>
                  </div>
                  <span class="card-link" aria-hidden="true">
                    Find out more
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- {
      featuredResearch.length > 0 && (
        <section class="featured-section" aria-labelledby="featured-heading">
          <div class="section-top">
            <div>
              <p class="eyebrow">From methods to applications</p>
              <h2 id="featured-heading">Research in focus</h2>
            </div>
          </div>
          <div class="feature-grid">
            {featuredResearch.map((feature, index) => (
              <article
                class:list={[
                  "feature-card",
                  { "feature-card--dark": index % 2 === 0 },
                ]}
              >
                {feature.image && (
                  <img
                    src={feature.image.src}
                    alt={feature.image.alt}
                    width="720"
                    height="400"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="feature-copy">
                  <p class="feature-category">{feature.category}</p>
                  <h3>{feature.title}</h3>
                  <p class="feature-description">{feature.description}</p>
                  <a href={feature.href}>
                    Explore the research <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>
      )
    } -->

    <section>
      <PublicationList limit={4} viewAllHref=`${URL_BASE}/publications`>
        <p slot="intro" class="section-intro">
          Explore our current body of work.
        </p>
      </PublicationList>
    </section>

    {
      partners.length > 0 && (
        <section aria-labelledby="partners-heading">
          <div class="partners-section-top">
            <h2 id="partners-heading">Industrial collaborators</h2>
            <p class="section-intro">
              We work in close partnership with industry across formulation,
              specialty chemicals, and biopharmaceuticals
            </p>
          </div>
          <ul class="partner-grid">
            {partners.map((partner) => (
              <li class="partner">
                {partner.href ? (
                  <a
                    href={partner.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <img
                      src={partner.logo}
                      alt={partner.name}
                      width="200"
                      height="90"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                ) : (
                  <img
                    src={partner.logo}
                    alt={partner.name}
                    width="200"
                    height="90"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section aria-labelledby="connection-heading">
      <div class="connection-section">
        <div class="connection-heading">
          <!-- <p class="eyebrow">People and partnerships</p> -->
          <h2 id="connection-heading">Interested in what we do?</h2>
        </div>
        <div class="connection-grid">
          <div>
            <h3>Meet the group</h3>
            <p>
              Get to know the people behind the research and explore their
              interests and projects.
            </p>
            <a class="text-link" href={site.groupHref}>
              Our members <ArrowRightIcon />
            </a>
          </div>
          <div>
            <h3>Join or collaborate</h3>
            <p>
              Interested in doctoral research or a collaboration? Get in touch
              to discuss your interests and engineering questions.
            </p>
            <a class="text-link" href={site.contactHref}
              >Get in touch <ArrowRightIcon /></a
            >
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  section {
    padding-block: 3.5rem;
    border-block-end: 1px solid var(--clr-border);
    scroll-margin-top: var(--research-anchor-offset, 6rem);

    &:last-child {
      border: none;
    }
  }

  h1,
  h2,
  h3 {
    line-height: 1.3;
    text-wrap: balance;
    font-family: var(--ff-heading);
  }
  h1 {
    line-height: 1.15;
  }
  h2 {
    font-size: var(--fs-heading);
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  h3 {
    font-size: var(--fs-subheading);
    font-weight: 600;
  }
  p,
  h3 {
    overflow-wrap: anywhere;
  }
  a {
    color: inherit;
  }
  a:focus-visible {
    outline: 3px solid var(--clr-primary);
    outline-offset: 5px;
  }
  .eyebrow {
    color: var(--clr-primary);
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 1ch;
    font-size: var(--fs-small);
    text-decoration: none;

    & :global(svg) {
      width: 1.5ch;
      height: 1.5ch;
    }
  }
  .text-link:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 0.4fr);
    align-items: center;
    gap: 4rem;
    height: min(28rem, 80dvh);
  }
  .hero-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .status-dot {
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    background: currentColor;
    border-radius: 50%;
  }
  h1 {
    max-width: 20ch;
    /* font-family: Georgia, "Times New Roman", serif; */
    font-size: var(--fs-title);
    font-weight: 600;
    letter-spacing: -0.045em;
  }
  h1 em {
    color: var(--clr-primary);
    /* font-weight: 600; */
  }
  .hero-description {
    max-width: 49ch;
    font-size: var(--fs-subheading);
    /* color: var(--clr-text-light); */

    & em {
      color: var(--clr-primary);
      font-weight: 800;
      font-style: normal;
    }
  }
  .button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-block-start: 1rem;
  }
  .button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 1.4rem;
    padding: 0.85rem 1.2rem;
    border: 1px solid var(--clr-text);
    border-radius: 0.25rem;
    text-decoration: none;
  }
  .button--primary {
    background: var(--clr-text);
    color: var(--clr-bg);
  }
  .button--primary:hover {
    background: var(--clr-primary);
    border-color: var(--clr-primary);
  }
  .button--outline:hover {
    background: var(--clr-bg-dark);
  }
  .hero-caption {
    color: var(--clr-text-light);
    font-size: var(--fs-small);
  }
  .hero-visual {
    position: relative;
    overflow: hidden;
    min-width: 0;
    padding: 1.6rem;
    border-radius: 0.4rem;
    background: var(--clr-bg-dark);
    border: 1px solid var(--clr-border);
  }
  .visual-heading {
    font-size: var(--fs-small);
    color: var(--clr-text-light);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero-network {
    display: block;
    width: 100%;
    max-height: 22rem;
    color: var(--clr-primary);
  }
  .orbit {
    stroke-dasharray: 3 8;
    opacity: 0.4;
  }
  .orbit--inner {
    stroke-dasharray: none;
    opacity: 0.15;
  }
  .network-lines {
    stroke-width: 1;
    opacity: 0.45;
  }
  .network-nodes {
    fill: var(--clr-bg);
    stroke: var(--clr-primary);
    stroke-width: 1.5;
  }
  .network-centre {
    fill: var(--clr-primary);
  }
  .visual-labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--clr-border);
  }
  .visual-labels span {
    font-size: var(--fs-small);
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--clr-border);
    background: var(--clr-bg);
    border-radius: 2rem;
  }
  .hero-visual--photo {
    padding: 0;
  }
  .hero-visual--photo img {
    width: 100%;
    aspect-ratio: 6 / 7;
    object-fit: cover;
  }

  .introduction {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: 4rem;
  }
  .introduction h2 {
    max-width: 35ch;
    font-size: var(--fs-heading);
  }
  .introduction-photo {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--clr-text-light);
    background: var(--clr-bg-dark);
    min-height: 20rem;
  }
  .introduction-copy {
    color: var(--clr-text-light);
  }
  .introduction-copy p + p {
    margin-top: 1rem;
  }
  .research-section,
  .featured-section,
  .publications-section,
  .partners-section {
    padding-block: 4rem;
  }
  #research {
    scroll-margin-top: var(--research-anchor-offset, 6rem);
  }
  .section-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }
  .section-intro {
    max-width: 55ch;
    color: var(--clr-text-light);
  }
  .research-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-block-start: 2rem;
  }
  .research-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--clr-border);
    border-radius: 0.35rem;
    background: var(--clr-bg-dark);
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .research-card-inner {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 1rem;
    padding: 1.5rem;
  }
  .card-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--clr-primary);
    margin-block-end: 0.5rem;
  }
  .card-index {
    font-size: var(--fs-small);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .card-arrow {
    transition: translate 100ms ease-out;
  }
  .card-arrow :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }
  .research-card:hover {
    border-color: var(--clr-primary);
    /* transform: translateY(-3px); */

    & .card-arrow {
      translate: 3px -3px;
    }
  }
  .research-card h3 {
    max-width: 24ch;
    line-height: 1.25;
  }
  .research-card p {
    margin-top: 0.25rem;
    color: var(--clr-text-light);
  }
  .card-link {
    margin-top: auto;
    color: var(--clr-primary);
    font-size: var(--fs-small);
    font-weight: 600;
    width: fit-content;

    &:hover {
      text-decoration: underline;
    }
  }
  .research-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .featured-section {
    padding-top: 0;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
  }
  .feature-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--clr-bg-dark);
    border-radius: 0.35rem;
  }
  .feature-card > img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .feature-copy {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 2.4rem;
  }
  .feature-category {
    font-size: var(--fs-small);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--clr-primary);
  }
  .feature-card h3 {
    margin-top: 1.5rem;
    max-width: 21ch;
    /* font-family: Georgia, "Times New Roman", serif; */
    font-size: var(--fs-heading);
    font-weight: 400;
    letter-spacing: -0.025em;
  }
  .feature-description {
    margin-top: 1.1rem;
    color: var(--clr-text-light);
  }
  .feature-card a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
    padding-top: 2rem;
    font-size: var(--fs-small);
    text-decoration: none;
  }
  .feature-card a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .feature-card--dark {
    background: var(--clr-text);
    color: var(--clr-bg);
  }
  .feature-card--dark .feature-category {
    color: var(--clr-primary-light);
  }
  .feature-card--dark .feature-description {
    color: var(--clr-bg-light);
  }
  .feature-card--dark a:focus-visible {
    outline-color: var(--clr-primary-light);
  }

  .publications-section {
    padding-top: 0;
  }
  .publication-list {
    padding: 0;
    list-style: none;
  }
  .publication {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 1.6rem;
    border-top: 1px solid var(--clr-border);
  }
  .publication:last-child {
    border-bottom: 1px solid var(--clr-border);
  }
  .publication-year {
    color: var(--clr-primary);
    padding-top: 0.2rem;
    font-size: var(--fs-small);
    font-variant-numeric: tabular-nums;
  }
  .publication h3 {
    max-width: 75ch;
    font-size: var(--fs-subheading);
    line-height: 1.45;
  }
  .publication a {
    text-decoration: none;
  }
  .publication a:hover {
    color: var(--clr-primary);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .publication-note {
    margin-top: 0.55rem;
    color: var(--clr-text-light);
  }
  .publication-meta {
    margin-top: 0.65rem;
    color: var(--clr-text-light);
    font-size: var(--fs-small);
  }

  /* .partners-section-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  } */
  .partner-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 1rem;
    /* margin-inline: auto; */
    list-style: none;
    margin-top: 2rem;
    max-width: min(52rem, 100%);

    /* display: flex;
    flex-wrap: wrap;
    justify-content: center; */
  }
