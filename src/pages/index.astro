                    Explore the research <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>
      )
    } -->

    <section>
      <PublicationList
        limit={3}
        columnLayout={true}
        title="Some recent publications"
        viewAllHref=`${URL_BASE}/publications`
      >
        <p slot="intro" class="section-intro">
          Explore the latest research from our group.
        </p>
      </PublicationList>
    </section>

    {
      partners.length > 0 && (
        <section aria-labelledby="partners-heading">
          <div class="partners-section-top">
            <h2 id="partners-heading">Industrial collaborators</h2>
            <p class="section-intro">
              We work in close partnership with industry across formulation,
              specialty chemicals, and biopharmaceuticals.
            </p>
          </div>
          <ul class="partner-grid">
            {partners.map((partner) => (
              <li class="partner" title={partner.name}>
                {partner.href ? (
                  <a
                    href={partner.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <img
                      src={partner.logo}
                      alt={partner.name}
                      width="200"
                      height="90"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                ) : (
                  <img
                    src={partner.logo}
                    alt={partner.name}
                    width="200"
                    height="90"
                    loading="lazy"
                    decoding="async"
