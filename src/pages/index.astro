    <section class="connection-section" aria-labelledby="connection-heading">
      <div class="connection-container">
        <div class="connection-heading">
          <!-- <p class="eyebrow">People and partnerships</p> -->
          <h2 id="connection-heading">Interested in what we do?</h2>
        </div>
        <div class="connection-grid">
          <div>
            <h3>Meet the group</h3>
            <p>
              Get to know the people behind the research and explore their
              interests and projects.
            </p>
            <a class="text-link" href={site.groupHref}>
              Our members <ArrowRightIcon />
            </a>
          </div>
          <div>
            <h3>Join or collaborate</h3>
            <p>
              Interested in doctoral research or a collaboration? Get in touch
              to discuss your interests and engineering questions.
            </p>
            <a class="text-link" href={site.contactHref}
              >Get in touch <ArrowRightIcon /></a
            >
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  section {
    padding-block: 3.5rem;
    /* border-block-end: 1px solid var(--clr-border-strong); */
    scroll-margin-top: var(--research-anchor-offset, 6rem);

    /* &:last-child {
      border: none;
    } */
  }

  h1,
  h2,
  h3 {
    line-height: 1.3;
    text-wrap: balance;
    font-family: var(--ff-heading);
  }
  h1 {
    line-height: 1.15;
  }
  h2 {
    font-size: var(--fs-heading);
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  h3 {
    font-size: var(--fs-subheading);
    font-weight: 600;
  }
  p,
  h3 {
    overflow-wrap: anywhere;
  }
  a {
    color: inherit;
  }
  a:focus-visible {
    outline: 3px solid var(--clr-primary-base);
    outline-offset: 5px;
  }
  .eyebrow {
    color: var(--clr-primary-base);
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 1ch;
    font-size: var(--fs-small);
    text-decoration: none;

    & :global(svg) {
      width: 1.5ch;
      height: 1.5ch;
    }
  }
  .text-link:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .hero-section {
    color: var(--clr-text-inverse);
    /* background: var(--clr-dark-background); */

    background-color: #17244a;
    background-image:
      radial-gradient(
        ellipse 80% 100% at 85% 15%,
        rgb(67 94 141 / 15%) 0%,
        transparent 70%
      ),
      linear-gradient(120deg, #121d3d 0%, #17244a 80%, #1a2949 100%);

    /* grid-column: full-width; */
    position: relative;
    isolation: isolate;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 0.4fr);
    align-items: center;
    gap: 4rem;
    /* min-height: 26rem; */
    height: min(38rem, 67svh, max(90vw, 26rem));
  }
  .hero-section::before {
    --_background-size: 288px;

    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    border-radius: inherit;

    background-image: url("/images/hero-background-tile.svg");
    background-repeat: repeat;
    background-size: var(--_background-size) var(--_background-size);

    /* Overall pattern strength */
    opacity: 0.25;
    filter: brightness(0) invert(1);

    /* Quieter behind the text, clearer toward the right */
    --pattern-fade: linear-gradient(
      to right,
      rgb(0 0 0 / 12%) 0%,
      rgb(0 0 0 / 22%) 43%,
      black 100%
    );

    /* -webkit-mask-image: var(--pattern-fade);
    mask-image: var(--pattern-fade); */

    animation: hero-drift 200s linear infinite;
  }

  @keyframes hero-drift {
    from {
      background-position: 0 0;
    }
    to {
      background-position: calc(7 * var(--_background-size))
        calc(1 * var(--_background-size));
    }
  }
  .hero-button-white {
    background: var(--clr-dark-background);
    border-color: var(--clr-text-inverse);
    color: var(--clr-text-inverse);

    &:hover {
      color: var(--clr-dark-background);
      background: var(--clr-text-inverse);
    }
  }
  .hero-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block-end: 1rem;
  }
  .status-dot {
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    background: currentColor;
    border-radius: 50%;
  }
  h1 {
    max-width: 18ch;
    color: var(--clr-primary-soft);
    /* font-family: Georgia, "Times New Roman", serif; */
    font-size: var(--fs-title);
    font-weight: 600;
    letter-spacing: -0.045em;
  }
  h1 em {
    /* color: var(--clr-secondary-base); */
    /* font-weight: 600; */
  }
  .hero-description {
    max-width: 49ch;
    font-size: var(--fs-subheading);
    /* color: var(--clr-primary-soft); */
    /* color: var(--clr-text-muted); */

    & em {
      background: var(--clr-primary-soft);
      border-radius: 0.1rem;
      /* border-radius: 0.25rem;
      padding-inline: 0.15ch; */
      padding-inline: 0.15ch;
      margin-inline: 0.05ch;
      color: var(--clr-primary-base);
      font-weight: 800;
      font-style: normal;

      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }
  }
  .button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-block-start: 1rem;
  }
  .button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 1.4rem;
    padding: 0.85rem 1.2rem;
    border: 1px solid var(--clr-text-body);
    border-radius: 0.25rem;
    text-decoration: none;
  }
  .button--primary {
    background: var(--clr-text-body);
    color: var(--clr-page-background);
  }
  .button--primary:hover {
    background: var(--clr-primary-base);
    border-color: var(--clr-primary-base);
  }
  .button--outline:hover {
    background: var(--clr-section-background);
  }
  .hero-caption {
    color: var(--clr-text-muted);
    font-size: var(--fs-small);
  }
  .hero-graphic {
    position: absolute;
    inset: 0;
    pointer-events: none;

    display: flex;
    justify-content: flex-end;

    & :global(svg) {
      height: 100%;
      width: auto;
    }
  }

  .hero-visual {
    position: relative;
    overflow: hidden;
    min-width: 0;
    padding: 1.6rem;
    border-radius: 0.4rem;
    background: var(--clr-section-background);
    border: 1px solid var(--clr-border-strong);
  }
  .visual-heading {
    font-size: var(--fs-small);
    color: var(--clr-text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero-network {
    display: block;
    width: 100%;
    max-height: 22rem;
    color: var(--clr-primary-base);
  }
  .orbit {
    stroke-dasharray: 3 8;
    opacity: 0.4;
  }
  .orbit--inner {
    stroke-dasharray: none;
    opacity: 0.15;
  }
  .network-lines {
    stroke-width: 1;
    opacity: 0.45;
  }
  .network-nodes {
    fill: var(--clr-page-background);
    stroke: var(--clr-primary-base);
    stroke-width: 1.5;
  }
  .network-centre {
    fill: var(--clr-primary-base);
  }
  .visual-labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--clr-border-strong);
  }
  .visual-labels span {
    font-size: var(--fs-small);
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--clr-border-strong);
    background: var(--clr-page-background);
    border-radius: 2rem;
  }
  .hero-visual--photo {
    padding: 0;
  }
  .hero-visual--photo img {
    width: 100%;
    aspect-ratio: 6 / 7;
    object-fit: cover;
  }

  .introduction {
    display: grid;
    grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.45fr);
    align-items: center;
    gap: 4rem;
  }
  .introduction h2 {
    max-width: 35ch;
    font-size: var(--fs-heading);
  }
  .introduction-photo {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--clr-text-muted);
    /* background: var(--clr-primary-soft); */
    min-height: 20rem;
    font-weight: 600;
  }
  .introduction-copy {
    /* color: var(--clr-text-muted); */
    font-size: var(--fs-subheading);
  }
  .introduction-copy p + p {
    margin-top: 1rem;
  }
  .research-section,
  .featured-section,
  .publications-section,
  .partners-section {
    padding-block: 4rem;
  }
  #research {
    scroll-margin-top: var(--research-anchor-offset, 6rem);
  }
  .section-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }
  .section-intro {
    max-width: 62ch;
    margin-block-start: 0.25rem;
    /* color: var(--clr-text-muted); */
  }
  .research-section {
    /* background: var(--clr-primary-base);
    color: var(--clr-text-inverse); */
    background: var(--clr-section-background);
  }
  .research-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    row-gap: 3rem;
    column-gap: 3rem;
    margin-block-start: 2rem;
  }
  .research-card-flat {
    border-top: 3px solid var(--clr-primary-base);
    /* padding-inline: 0.5rem; */
    display: flex;
    flex-direction: column;
    height: 100%;
    padding-block-start: 1rem;
    gap: 2rem;
  }
  .research-card-header {
    display: flex;
    justify-content: space-between;
    /* align-items: center; */
    gap: 2rem;
  }
  .research-card-header-icon {
    color: var(--clr-primary-base);
    width: 3.5rem;
    height: 2.25rem;
    /* display: none; */
  }
  .research-card {
    width: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
