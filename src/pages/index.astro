---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { LONG_TITLE } from "../consts";

const site = {
  groupName: LONG_TITLE, // Replace with your agreed group name.
  groupHref: "/group",
  publicationsHref: "/publications",
  contactHref: "/contact",
};

// Optional: a laboratory, group or research image from your public/ directory.
const media: { hero?: { src: string; alt: string } } = {
  // hero: { src: "/images/research.webp", alt: "[Describe the research shown]" },
};
const heroImage = media.hero;

interface Partner {
  name: string;
  logo: string; // Public asset URL, e.g. /images/partners/company.svg
  href?: string;
}
// Add confirmed collaborators and their approved logos. Empty = section hidden.
const partners: Partner[] = [
  {
    name: "Croda",
    logo: "/images/logos/croda.png",
    href: "https://www.croda.com/en-gb",
  },
  {
    name: "BP",
    logo: "/images/logos/bp.png",
    href: "[Partner URL]",
  },
  {
    name: "CPACT",
    logo: "/images/logos/cpact.png",
    href: "[Partner URL]",
  },
  {
    name: "Applied Materials",
    logo: "/images/logos/applied-materials.png",
    href: "[Partner URL]",
  },
  {
    name: "Johnson Matthey",
    logo: "/images/logos/johnson-matthey.svg",
    href: "[Partner URL]",
  },
  {
    name: "Keit Industrial Analytics",
    logo: "/images/logos/keit-industrial-analytics.png",
    href: "[Partner URL]",
  },
  {
    name: "Unilever",
    logo: "/images/logos/unilever.svg",
    href: "[Partner URL]",
  },
];

interface Feature {
  category: string;
  title: string;
  description: string;
  href: string;
  image?: { src: string; alt: string };
}
// These are research examples, rather than claims about active project status.
// Replace or expand them with your group's chosen projects and images.
const featuredResearch: Feature[] = [
  {
    category: "Bioprocess engineering",
    title: "Predicting performance across scales",
    description:
      "How can laboratory and pilot-scale data help predict industrial fermentation? We investigate hybrid models that combine process knowledge with data and adapt between scales.",
    href: "/research/bioprocess-engineering/",
  },
  {
    category: "Industrial analytics",
    title: "Making operational data useful",
    description:
      "Industrial sensor histories contain information about quality and equipment condition. We develop soft sensors and predictive-maintenance methods that make use of these records, including trajectories with missing failure labels.",
    href: "/research/industrial-analytics/",
  },
];

const researchAreas = (await getCollection("research")).sort(
  (a, b) => a.data.pos - b.data.pos || a.data.title.localeCompare(b.data.title),
);
const researchHref = (id: string) => `/research/${id}/`;

type Publication = CollectionEntry<"research">["data"]["publications"][number];
const allPublications = researchAreas.flatMap((area) => area.data.publications);
const publicationByHref = new Map(
  allPublications.map((paper) => [paper.href, paper]),
);
const newestPublications = [...publicationByHref.values()].sort(
  (a, b) => b.year - a.year,
);

// Curated examples covering different applications. Missing entries fall back
// to other recent papers. Identical links are shown once, across all themes.
const selectedPublicationHrefs = [
  "https://doi.org/10.1002/bit.70385",
  "https://doi.org/10.1016/j.dche.2026.100313",
  "https://doi.org/10.1021/acs.jcim.5c03062",
];
const preferredPublications = selectedPublicationHrefs
  .map((href) => publicationByHref.get(href))
  .filter((paper): paper is Publication => paper !== undefined);
const selectedPublications = [
  ...new Map(
    [...preferredPublications, ...newestPublications].map((paper) => [
      paper.href,
      paper,
    ]),
  ).values(),
].slice(0, 3);

const publicationNotes: Record<string, string> = {
  "https://doi.org/10.1002/bit.70385":
    "Adapting hybrid bioprocess models for scale-up when data are limited.",
  "https://doi.org/10.1016/j.dche.2026.100313":
    "Reconstructing and grouping batch processing sequences from historical records.",
  "https://doi.org/10.1021/acs.jcim.5c03062":
    "Improving the fidelity and diversity of molecular candidates generated for targeted properties.",
};
---

<Layout>
  <main class="home-page" id="main-content">
    <header class="hero section-wrap">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="status-dot" aria-hidden="true"></span>{site.groupName}
        </p>
        <h1>Intelligent models for <em>complex processes.</em></h1>
        <p class="hero-description">
          We combine machine learning, physical modelling and process systems
          engineering to understand, design and improve chemical and biological
          systems.
        </p>
        <div class="button-row">
          <a class="button button--primary" href="#research"
            >Explore our research <span aria-hidden="true">↗</span></a
          >
          <a class="button button--outline" href={site.groupHref}
            >Meet the group</a
          >
        </div>
        <p class="hero-caption">
          From molecular design to industrial operation.
        </p>
      </div>

      <div
        class:list={[
          "hero-visual",
          { "hero-visual--photo": Boolean(heroImage) },
        ]}
      >
        {
          heroImage ? (
            <img
              src={heroImage.src}
              alt={heroImage.alt}
              width="720"
              height="840"
              fetchpriority="high"
            />
          ) : (
            <>
              <p class="visual-heading">Knowledge. Data. Decisions.</p>
              <svg
                class="hero-network"
                viewBox="0 0 400 380"
                aria-hidden="true"
                focusable="false"
              >
                <g fill="none" stroke="currentColor">
                  <circle class="orbit" cx="200" cy="190" r="144" />
                  <circle class="orbit orbit--inner" cx="200" cy="190" r="94" />
                  <path
                    class="network-lines"
                    d="M62 143 151 63 294 104 339 244 239 321 107 283 62 143M151 63 200 190 294 104M62 143 200 190 339 244M107 283 200 190 239 321M151 63 294 104 239 321 107 283 151 63"
                  />
                </g>
                <g class="network-nodes">
                  <>
                    <circle cx="62" cy="143" r="7" />
                    <circle cx="151" cy="63" r="7" />
                  </>
                  <>
                    <circle cx="294" cy="104" r="7" />
                    <circle cx="339" cy="244" r="7" />
                  </>
                  <>
                    <circle cx="239" cy="321" r="7" />
                    <circle cx="107" cy="283" r="7" />
                  </>
                  <circle class="network-centre" cx="200" cy="190" r="14" />
                </g>
              </svg>
              <div class="visual-labels">
                <span>Physical understanding</span>
                <span>Machine intelligence</span>
                <span>Engineering decisions</span>
              </div>
            </>
          )
        }
      </div>
    </header>

    <section
      class="introduction section-wrap"
      aria-labelledby="introduction-heading"
    >
      <div>
        <p class="eyebrow">Our perspective</p>
        <h2 id="introduction-heading">
          Connecting scientific understanding with engineering decisions.
        </h2>
      </div>
      <div class="introduction-copy">
        <p>
          Chemical and biological systems are complex, and the data available to
          describe them are often incomplete. We develop methods that bring
          engineering knowledge and machine learning together to build useful
          models under these conditions.
        </p>
        <p>
          Our research spans molecules, reactions, cells and manufacturing
          processes. Across these scales, we connect prediction with
          interpretation, design and operation.
        </p>
      </div>
    </section>

    {
      researchAreas.length > 0 && (
        <section
          class="research-section section-wrap"
          id="research"
          aria-labelledby="research-heading"
        >
          <div class="section-top">
            <div>
              <p class="eyebrow">Explore the work</p>
              <h2 id="research-heading">Research areas</h2>
            </div>
            <p class="section-intro">
              Distinct engineering questions. Connected methods and ideas.
            </p>
          </div>
          <div class="research-grid">
            {researchAreas.map((area, index) => (
              <a
                class="research-card"
                href={researchHref(area.id)}
                aria-labelledby={`area-heading-${index}`}
              >
                {area.data.coverImage && (
                  <img
                    class="research-image"
                    src={area.data.coverImage.src}
                    width={area.data.coverImage.width}
                    height={area.data.coverImage.height}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="research-card-inner">
                  <div class="card-topline">
                    <span class="card-index" aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <span class="card-arrow" aria-hidden="true">
                      ↗
                    </span>
                  </div>
                  <h3 id={`area-heading-${index}`}>{area.data.title}</h3>
                  <p>{area.data.subtitle}</p>
                  <span class="card-link" aria-hidden="true">
                    Explore this area
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      featuredResearch.length > 0 && (
        <section
          class="featured-section section-wrap"
          aria-labelledby="featured-heading"
        >
          <div class="section-top">
            <div>
              <p class="eyebrow">From methods to applications</p>
              <h2 id="featured-heading">Research in focus</h2>
            </div>
          </div>
          <div class="feature-grid">
            {featuredResearch.map((feature, index) => (
              <article
                class:list={[
                  "feature-card",
                  { "feature-card--dark": index % 2 === 0 },
                ]}
              >
                {feature.image && (
                  <img
                    src={feature.image.src}
                    alt={feature.image.alt}
                    width="720"
                    height="400"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="feature-copy">
                  <p class="feature-category">{feature.category}</p>
                  <h3>{feature.title}</h3>
                  <p class="feature-description">{feature.description}</p>
                  <a href={feature.href}>
                    Explore the research <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>
      )
    }

    {
      selectedPublications.length > 0 && (
        <section
          class="publications-section section-wrap"
          aria-labelledby="publications-heading"
        >
          <div class="section-top">
            <div>
              <p class="eyebrow">Ideas in print</p>
              <h2 id="publications-heading">Selected publications</h2>
            </div>
            <a class="text-link" href={site.publicationsHref}>
              All publications <span aria-hidden="true">↗</span>
            </a>
          </div>
          <ul class="publication-list">
            {selectedPublications.map((paper) => (
              <li class="publication">
                <span class="publication-year">{paper.year}</span>
                <div>
                  <h3>
                    <a href={paper.href}>
                      {paper.title}
                      <span aria-hidden="true"> ↗</span>
                    </a>
                  </h3>
                  {publicationNotes[paper.href] && (
                    <p class="publication-note">
                      {publicationNotes[paper.href]}
                    </p>
                  )}
                  <p class="publication-meta">
                    {paper.authors}
                    {paper.venue && (
                      <>
                        {" "}
                        <span aria-hidden="true">·</span> {paper.venue}
                      </>
                    )}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      partners.length > 0 && (
        <section
          class="partners-section section-wrap"
          aria-labelledby="partners-heading"
        >
          <div class="section-top">
            <div>
              <p class="eyebrow">Working together</p>
              <h2 id="partners-heading">Our collaborators</h2>
            </div>
            <p class="section-intro">
              Collaborations connect our research with practical engineering
              challenges.
            </p>
          </div>
          <ul class="partner-grid">
            {partners.map((partner) => (
              <li class="partner">
                {partner.href ? (
                  <a
                    href={partner.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <img
                      src={partner.logo}
                      alt={partner.name}
                      width="200"
                      height="90"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                ) : (
                  <img
                    src={partner.logo}
                    alt={partner.name}
                    width="200"
                    height="90"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section
      class="connection-section section-wrap"
      aria-labelledby="connection-heading"
    >
      <div class="connection-heading">
        <p class="eyebrow">People and partnerships</p>
        <h2 id="connection-heading">
          Good research starts with a conversation.
        </h2>
      </div>
      <div class="connection-grid">
        <div>
          <h3>Meet the group</h3>
          <p>
            Get to know the people behind the research and explore their
            interests and projects.
          </p>
          <a class="text-link" href={site.groupHref}
            >Our people <span aria-hidden="true">↗</span></a
          >
        </div>
        <div>
          <h3>Join or collaborate</h3>
          <p>
            Interested in doctoral research or a collaboration? Get in touch to
            discuss your interests and engineering questions.
          </p>
          <a class="text-link" href={site.contactHref}
            >Contact the group <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .home-page {
    --ink: #163330;
    --muted: #52645f;
    --accent: #1f7062;
    --line: #d8e1dc;
    --paper: #fbfcf9;
    --tint: #edf3ee;
    color: var(--ink);
    background: var(--paper);
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.65;
  }
  .home-page,
  .home-page * {
    box-sizing: border-box;
  }
  .section-wrap {
    width: min(72rem, calc(100% - 3rem));
    margin-inline: auto;
  }
  h1,
  h2,
  h3,
  p,
  ul {
    margin: 0;
  }
  h1,
  h2,
  h3 {
    line-height: 1.15;
    text-wrap: balance;
  }
  h2 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 500;
    letter-spacing: -0.035em;
  }
  h3 {
    font-size: 1.25rem;
    font-weight: 500;
  }
  p,
  h3 {
    overflow-wrap: anywhere;
  }
  a {
    color: inherit;
  }
  a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 5px;
  }
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .eyebrow {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .text-link:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: center;
    gap: 4rem;
    padding-block: 5rem 4.5rem;
  }
  .hero-copy {
    min-width: 0;
  }
  .hero .eyebrow {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    margin-bottom: 1.6rem;
  }
  .status-dot {
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    background: currentColor;
    border-radius: 50%;
  }
  h1 {
    max-width: 15ch;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3rem, 5.6vw, 5.2rem);
    font-weight: 400;
    letter-spacing: -0.045em;
  }
  h1 em {
    color: var(--accent);
    font-weight: 400;
  }
  .hero-description {
    max-width: 49ch;
    margin-top: 1.7rem;
    font-size: 1.1rem;
    color: var(--muted);
  }
  .button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }
  .button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 1.4rem;
    padding: 0.85rem 1.2rem;
    border: 1px solid var(--ink);
    border-radius: 0.25rem;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .button--primary {
    background: var(--ink);
    color: var(--paper);
  }
  .button--primary:hover {
    background: var(--accent);
    border-color: var(--accent);
  }
  .button--outline:hover {
    background: var(--tint);
  }
  .hero-caption {
    margin-top: 1.6rem;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .hero-visual {
    position: relative;
    overflow: hidden;
    min-width: 0;
    padding: 1.6rem;
    border-radius: 0.4rem;
    background: var(--tint);
    border: 1px solid var(--line);
  }
  .visual-heading {
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero-network {
    display: block;
    width: 100%;
    max-height: 22rem;
    margin-block: 0.6rem;
    color: var(--accent);
  }
  .orbit {
    stroke-dasharray: 3 8;
    opacity: 0.4;
  }
  .orbit--inner {
    stroke-dasharray: none;
    opacity: 0.15;
  }
  .network-lines {
    stroke-width: 1;
    opacity: 0.45;
  }
  .network-nodes {
    fill: var(--paper);
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  .network-centre {
    fill: var(--accent);
  }
  .visual-labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .visual-labels span {
    font-size: 0.72rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--line);
    background: var(--paper);
    border-radius: 2rem;
  }
  .hero-visual--photo {
    padding: 0;
  }
  .hero-visual--photo img {
    width: 100%;
    aspect-ratio: 6 / 7;
    object-fit: cover;
  }

  .introduction {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 5rem;
    padding-block: 3.5rem;
    border-block: 1px solid var(--line);
  }
  .introduction h2 {
    max-width: 24ch;
    margin-top: 0.9rem;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
  }
  .introduction-copy {
    color: var(--muted);
  }
  .introduction-copy p + p {
    margin-top: 1rem;
  }
  .research-section,
  .featured-section,
  .publications-section,
  .partners-section {
    padding-block: 4rem;
  }
  #research {
    scroll-margin-top: var(--research-anchor-offset, 6rem);
  }
  .section-top {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-bottom: 2rem;
  }
  .section-top h2 {
    margin-top: 0.75rem;
  }
  .section-intro {
    max-width: 37ch;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .research-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .research-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: #fff;
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .research-card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }
  .research-card-inner {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.65rem;
  }
  .card-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
    color: var(--accent);
  }
  .card-index {
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }
  .card-arrow {
    font-size: 1.25rem;
  }
  .research-card h3 {
    max-width: 24ch;
    line-height: 1.25;
  }
  .research-card p {
    margin-top: 0.85rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .card-link {
    margin-top: auto;
    padding-top: 1.8rem;
    color: var(--accent);
    font-size: 0.78rem;
  }
  .research-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .featured-section {
    padding-top: 0;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
  }
  .feature-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--tint);
    border-radius: 0.35rem;
  }
  .feature-card > img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .feature-copy {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 2.4rem;
  }
  .feature-category {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .feature-card h3 {
    margin-top: 1.5rem;
    max-width: 21ch;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.8rem, 3vw, 2.3rem);
    font-weight: 400;
    letter-spacing: -0.025em;
  }
  .feature-description {
    margin-top: 1.1rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .feature-card a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
    padding-top: 2rem;
    font-size: 0.85rem;
    text-decoration: none;
  }
  .feature-card a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .feature-card--dark {
    background: var(--ink);
    color: #f4f8f4;
  }
  .feature-card--dark .feature-category {
    color: #acd8c4;
  }
  .feature-card--dark .feature-description {
    color: #d0ded7;
  }
  .feature-card--dark a:focus-visible {
    outline-color: #acd8c4;
  }

  .publications-section {
    padding-top: 0;
  }
  .publication-list {
    padding: 0;
    list-style: none;
