---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PublicationItem from "../components/PublicationItem.astro";

const [publications, research, members] = await Promise.all([
  getCollection("publications", ({ data }) => !data.draft && !data.duplicateOf),
  getCollection("research"),
  getCollection("members"),
]);

const memberIDs = new Set(members.map((member) => member.id));
// Add aliases only after checking your actual member filenames.
const authorMemberAliases: Record<string, string> = {
  // 'ehecatl-del-rio-chanona': 'antonio-del-rio-chanona',
};
const memberIDFor = (authorID: string) =>
  authorMemberAliases[authorID] ?? authorID;
const topicID = (topic: string | { id: string }) =>
  typeof topic === "string" ? topic : topic.id;
const researchByID = new Map(research.map((area) => [area.id, area]));
const typeLabels: Record<string, string> = {
  "journal-article": "Journal article",
  "book-chapter": "Book chapter",
  "edited-book": "Edited book",
  preprint: "Preprint",
  "posted-content": "Preprint",
  "proceedings-article": "Conference paper",
  "conference-contribution": "Conference presentation",
};

// ISO strings preserve partial-date precision and sort without inventing dates.
publications.sort(
  (a, b) =>
    (b.data.publicationDate ?? "").localeCompare(
      a.data.publicationDate ?? "",
    ) || a.data.title.localeCompare(b.data.title),
);

const papers = await Promise.all(
  publications.map(async (entry) => {
    const { Content } = await render(entry);
    const data = entry.data;
    const year = data.publicationDate?.slice(0, 4) ?? "undated";
    const topics = data.researchTopics.map(topicID);
    return {
      entry,
      Content,
      year,
      topics,
      typeLabel: typeLabels[data.type] ?? "Publication",
      searchText: [
        data.title,
        ...data.authors.map((id) => data.authorNames[id] ?? id),
        data.journal ?? data.venue ?? "",
        data.doi ?? "",
        ...topics.map((id) => researchByID.get(id)?.data.title ?? id),
      ].join(" "),
    };
  }),
);
const years = [...new Set(papers.map((paper) => paper.year))];
const months = [
  "Jan",
  "Feb",
  "Mar",
  "Apr",
  "May",
  "Jun",
  "Jul",
  "Aug",
  "Sep",
  "Oct",
  "Nov",
  "Dec",
];
const groups = years.map((year) => ({
  year,
  papers: papers.filter((paper) => paper.year === year),
}));
const usedTopics = new Set(papers.flatMap((paper) => paper.topics));
const topicOptions = research
  .filter((area) => usedTopics.has(area.id))
  .sort((a, b) => a.data.pos - b.data.pos);
const authorOptions = members
  .filter((member) =>
    publications.some((paper) =>
      paper.data.authors.some((id) => memberIDFor(id) === member.id),
    ),
  )
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
const description =
  "Publications from our research in intelligent modelling, chemical engineering and process systems.";
---

<Layout title="Our Publications" description={description}>
  <div class="page-grid publications-page" data-publications>
    <section class="page-header">
      <!-- <p class="eyebrow">Research outputs</p> -->
      <h1>Our Publications</h1>
      <p class="intro">
        Explore our work across modelling, intelligent systems and chemical
        engineering.
      </p>
    </section>

    <section>
      <!-- Hidden until enhanced: the complete grouped list remains readable without JavaScript. -->
      <form
        class="filters"
        data-filters
        hidden
        role="search"
        aria-label="Filter publications"
      >
        <div class="field search-field" style="display: none">
          <label for="publication-search">Search publications</label>
          <input
            id="publication-search"
            name="q"
            type="search"
            placeholder="Title, author, journal or DOI"
            autocomplete="off"
          />
        </div>
        <div class="field">
          <label for="publication-topic">Research area</label>
          <select id="publication-topic" name="topic">
            <option value="">All research areas</option>
            {
              topicOptions.map((area) => (
                <option value={area.id}>
                  {area.data.shortTitle ?? area.data.title}
                </option>
              ))
            }
          </select>
        </div>
        <div class="field">
          <label for="publication-author">Group member</label>
          <select id="publication-author" name="author">
            <option value="">All authors</option>
            {
              authorOptions.map((member) => (
                <option value={member.id}>{member.data.name}</option>
              ))
            }
          </select>
        </div>
        <div class="field year-field">
          <label for="publication-year">Year</label>
          <select id="publication-year" name="year">
            <option value="">All years</option>
            {
              years.map((year) => (
                <option value={year}>
                  {year === "undated" ? "Date not available" : year}
                </option>
              ))
            }
          </select>
        </div>
        <button class="reset-button" type="reset">Clear filters</button>
      </form>
      <div class="list-toolbar">
        <p
          class="result-count"
          data-result-count
          role="status"
          aria-live="polite"
          aria-atomic="true"
        >
          {papers.length} publications · newest first
        </p>
        {
          years.length > 0 && (
            <nav class="year-navigation" aria-label="Jump to publication year">
              {groups.map((group) => (
                <a href={`#year-${group.year}`} data-year-link={group.year}>
                  {group.year === "undated" ? "Undated" : group.year}
                </a>
              ))}
            </nav>
          )
        }
      </div>
      <div class="publication-groups">
        {
          groups.map((group) => (
            <div
              class="year-group"
              data-year-group={group.year}
              aria-labelledby={`year-${group.year}`}
            >
              <div class="year-heading">
                <h2 id={`year-${group.year}`} tabindex="-1">
                  {group.year === "undated" ? "Date not available" : group.year}
                </h2>
                <span data-year-count>{group.papers.length}</span>
              </div>
              <ul class="publication-list">
                {group.papers.map(({ entry }) => (
                  <PublicationItem
                    publication={entry}
                    members={members}
                    research={research}
                    aliases={authorMemberAliases}
                    headingID={`publication-${entry.id}`}
                  />
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="empty-state" data-empty hidden>
        <h2>No matching publications</h2>
        <p>Try a different search term or clear the filters.</p>
        <button type="button" data-clear>Clear filters</button>
      </div>
      {
        papers.length === 0 && (
          <p>Publications will appear here as they are added.</p>
        )
      }
      <noscript
        ><p>
          Browse by year using the links above. Search and filters require
          JavaScript.
        </p></noscript
      >
      <a class="back-to-top" href="#">Back to top ↑</a>
    </section>
  </div>
</Layout>

<script>
  // Runs on ordinary loads and when navigating with Astro's ClientRouter.
  // Cleanup prevents global listeners accumulating across page transitions.
  let cleanup: (() => void) | undefined;
  function initialisePublications() {
    cleanup?.();
    cleanup = undefined;
    const root = document.querySelector<HTMLElement>("[data-publications]");
    if (!root) return;
    const form = root.querySelector<HTMLFormElement>("[data-filters]")!;
    const search = form.querySelector<HTMLInputElement>('[name="q"]')!;
    const topic = form.querySelector<HTMLSelectElement>('[name="topic"]')!;
    const author = form.querySelector<HTMLSelectElement>('[name="author"]')!;
    const year = form.querySelector<HTMLSelectElement>('[name="year"]')!;
    const count = root.querySelector<HTMLElement>("[data-result-count]")!;
    const empty = root.querySelector<HTMLElement>("[data-empty]")!;
    const groups = Array.from(
      root.querySelectorAll<HTMLElement>("[data-year-group]"),
    );
    const yearLinks = Array.from(
      root.querySelectorAll<HTMLAnchorElement>("[data-year-link]"),
    );
    const normalise = (text: string) =>
      text
        .normalize("NFKD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase();
    const papers = Array.from(
      root.querySelectorAll<HTMLElement>("[data-paper]"),
    ).map((element) => ({
      element,
      search: normalise(element.dataset.search ?? ""),
      topics: JSON.parse(element.dataset.topics ?? "[]") as string[],
      year: element.dataset.year ?? "",
      authors: JSON.parse(element.dataset.authors ?? "[]") as string[],
    }));
    const controller = new AbortController();
    const options = { signal: controller.signal };
    cleanup = () => controller.abort();

    function update(writeURL = true) {
      const terms = normalise(search.value.trim()).split(/\s+/).filter(Boolean);
      let visible = 0;
      const counts = new Map<string, number>();
      for (const paper of papers) {
        const matches =
          terms.every((term) => paper.search.includes(term)) &&
          (!topic.value || paper.topics.includes(topic.value)) &&
          (!author.value || paper.authors.includes(author.value)) &&
          (!year.value || paper.year === year.value);
        paper.element.hidden = !matches;
        if (matches) {
          visible++;
          counts.set(paper.year, (counts.get(paper.year) ?? 0) + 1);
        }
        // Keep an expanded abstract from unexpectedly reopening after filters change.
        if (!matches)
          paper.element.querySelector("details")?.removeAttribute("open");
      }
      for (const group of groups) {
        const groupCount = counts.get(group.dataset.yearGroup ?? "") ?? 0;
        group.hidden = groupCount === 0;
        group.querySelector<HTMLElement>("[data-year-count]")!.textContent =
          String(groupCount);
      }
      for (const link of yearLinks)
        link.hidden = !counts.has(link.dataset.yearLink ?? "");
      count.textContent = `${visible} of ${papers.length} publications · newest first`;
      empty.hidden = visible !== 0;
      root
        ?.querySelectorAll<HTMLElement>("[data-author-id]")
        .forEach((element) => {
          element.classList.toggle(
            "highlighted-author",
            Boolean(author.value) && element.dataset.authorId === author.value,
          );
        });
      if (writeURL) {
        const url = new URL(window.location.href);
        for (const [key, value] of [
          ["q", search.value.trim()],
          ["topic", topic.value],
          ["author", author.value],
          ["year", year.value],
        ]) {
          if (value) url.searchParams.set(key, value);
          else url.searchParams.delete(key);
        }
        // A previous year anchor may now be hidden; keep filter links unambiguous.
        if (url.hash.startsWith("#year-")) url.hash = "";
        history.replaceState(history.state, "", url);
      }
    }
    function restore() {
      const params = new URL(window.location.href).searchParams;
      search.value = params.get("q") ?? "";
      for (const [select, key] of [
        [topic, "topic"],
        [author, "author"],
        [year, "year"],
      ] as const) {
        const value = params.get(key) ?? "";
        select.value = Array.from(select.options).some(
          (option) => option.value === value,
        )
          ? value
          : "";
      }
      update(false);
    }
    function clear() {
      search.value = "";
      topic.value = "";
      author.value = "";
      year.value = "";
      update();
      search.focus();
    }
    form.addEventListener(
      "submit",
      (event) => {
        event.preventDefault();
        update();
      },
      options,
    );
    search.addEventListener("input", () => update(), options);
    topic.addEventListener("change", () => update(), options);
    author.addEventListener("change", () => update(), options);
    year.addEventListener("change", () => update(), options);
    form.addEventListener(
      "reset",
      (event) => {
        event.preventDefault();
        clear();
      },
      options,
    );
    root
      .querySelector("[data-clear]")
      ?.addEventListener("click", clear, options);
    window.addEventListener("popstate", restore, options);
    // In case this document is restored from the browser's back-forward cache.
    window.addEventListener(
      "pageshow",
      (event) => {
        if (event.persisted) restore();
      },
      options,
    );
    form.hidden = false;
    restore();
  }
  initialisePublications();
  document.addEventListener("astro:page-load", initialisePublications);
</script>

<style>
  .publications-page {
    --content-max-width: 960px;
  }
  section {
    scroll-margin-top: var(--research-anchor-offset, 6rem);

    &:first-child {
      padding-block: 3.5rem;
    }
  }
  h1 {
    margin: 0;
    font-size: var(--fs-title);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.1;
  }
  .intro {
    color: var(--clr-text-light);
    font-size: var(--fs-subheading);
    line-height: 1.6;
    max-width: 50ch;
  }
  .filters {
    display: grid;
    /* grid-template-columns:
      minmax(180px, 1.4fr) repeat(2, minmax(140px, 1fr))
      90px auto; */
    grid-template-columns:
      repeat(2, minmax(140px, 1fr)) repeat(2, minmax(80px, 0.6fr))
      auto;
    gap: 0.8rem;
    align-items: end;
    padding: 1rem;
    background: var(--clr-bg-dark);
    border: 1px solid var(--clr-border);
    border-radius: 12px;
  }
  .field {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }
  label {
    font-size: var(--fs-small);
    font-weight: 600;
  }
  input,
  select,
  button {
    font: inherit;
  }
  input,
  select {
    width: 100%;
    min-height: 44px;
    padding: 0.6rem 0.7rem;
    border: 1px solid var(--clr-border);
    border-radius: 6px;
    background: var(--clr-bg-light);
    color: var(--clr-text-light);
    /* font-size: var(--fs-small); */
  }
  input::placeholder {
    color: var(--clr-text-light);
  }
  button {
    min-height: 44px;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--clr-border);
    border-radius: 6px;
    background: var(--clr-bg-light);
    color: var(--clr-primary);
    cursor: pointer;
    /* font-size: var(--fs-small); */
    font-weight: 600;
  }
  button:hover {
    background: var(--clr-bg);
  }
  a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  :is(a, button, input, select, summary):focus-visible {
    outline: 3px solid var(--clr-primary);
    outline-offset: 3px;
  }
  .list-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 1.25rem 0 2rem;
  }
  .result-count {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--clr-text-light);
  }
  .year-navigation {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .year-navigation a {
    padding: 0.3rem 0.45rem;
    color: var(--clr-primary);
    font-size: var(--fs-small);
    text-decoration: none;
    border-radius: 4px;
  }
  .year-navigation a:hover {
    background: var(--clr-bg-dark);
    text-decoration: underline;
  }
  .year-group {
    margin-bottom: 2.5rem;
  }
  .year-heading {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    border-bottom: 2px solid var(--clr-text);
    padding-bottom: 0.6rem;
  }
  .year-heading h2 {
    margin: 0;
    font-size: var(--fs-heading);
    letter-spacing: -0.03em;
    scroll-margin-top: 6rem;
  }
  .year-heading > span {
    color: var(--clr-text-light);
    font-size: var(--fs-small);
  }
  .publication-list,
  .topic-tags {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .publication {
    padding: 1.45rem 0;
    border-bottom: 1px solid var(--clr-border);
  }
  .paper-meta {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    color: var(--clr-text-light);
    font-size: var(--fs-small);
  }
  .paper-type {
    font-weight: 600;
    color: var(--clr-primary);
  }
  h3 {
    margin: 0.45rem 0;
    font-size: var(--fs-subheading);
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.015em;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--clr-primary);
    text-decoration: underline;
  }
  .authors {
    margin: 0.45rem 0;
    color: var(--clr-text-light);
    line-height: 1.6;
    max-width: none;
  }
  .authors a {
    color: var(--clr-primary);
  }
  .venue {
    margin: 0.4rem 0;
    font-style: italic;
    line-height: 1.5;
  }
  .paper-footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.8rem;
  }
  .topic-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .topic-tags a {
    display: block;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    background: var(--clr-bg-dark);
    color: var(--clr-primary);
    font-size: var(--fs-small);
    text-decoration: none;
  }
  .topic-tags a:hover {
    text-decoration: underline;
    background: var(--clr-bg-dark);
  }
  .publication-link {
    font-size: var(--fs-small);
    color: var(--clr-primary);
    white-space: nowrap;
  }
  .abstract {
    margin-top: 0.85rem;
  }
  summary {
    width: fit-content;
    color: var(--clr-primary);
    font-size: var(--fs-small);
    font-weight: 600;
    cursor: pointer;
  }
  .abstract-body {
    max-width: 78ch;
    margin-top: 0.8rem;
    padding: 0.1rem 1rem;
    border-left: 2px solid var(--clr-border);
    color: var(--clr-text-light);
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  .abstract-body :global(h2) {
    margin: 0.7rem 0;
  }
  .abstract-body :global(p) {
    margin: 0.75rem 0;
  }
  .abstract-body :global(a) {
    color: var(--clr-primary);
  }
  .empty-state {
    padding: 2rem 1rem;
    text-align: center;
    border: 1px dashed var(--clr-border);
    border-radius: 8px;
  }
  .empty-state h2 {
    font-size: var(--fs-subheading);
  }
  .empty-state p {
    color: var(--clr-text-light);
  }
  .back-to-top {
    display: inline-block;
    color: var(--clr-primary);
    font-size: var(--fs-small);
    margin-top: 0.5rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 850px) {
    .filters {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    /* .search-field {
      grid-column: 1 / -1;
    }
    .year-field {
      grid-column: 2;
    }
    .reset-button {
      grid-column: 1 / -1;
      justify-self: start;
    } */
  }
  @media (max-width: 480px) {
    .filters {
      grid-template-columns: 1fr;
    }
    .search-field,
    .year-field,
    .reset-button {
      grid-column: auto;
    }
    .publication {
      padding: 1.2rem 0;
    }
    .paper-footer {
      align-items: flex-start;
    }
    .topic-tags {
      flex: 1 1 100%;
    }
  }
  @media print {
    .filters,
    .year-navigation,
    .back-to-top,
    summary,
    .empty-state {
      display: none !important;
    }
    .publication {
      break-inside: avoid;
    }
    .abstract-body {
      display: none;
    }
    .publications-page {
      padding: 0;
      max-width: none;
    }
  }
</style>
