---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { ABBR_TITLE, CONTACT_EMAIL, SHORT_TITLE, URL_BASE } from "../../consts";
import MemberCard from "../../components/MemberCard.astro";
import FeaturedLead from "../../components/FeaturedLead.astro";

// : CollectionEntry<"members">
const members = (await getCollection("members")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const isSupervisor = (role: string) => /\bsupervisor\b/i.test(role);
const current = members
  .filter((member) => member.data.type !== "alumni")
  .sort(
    (a, b) =>
      (a.data.startDate?.getTime() ?? Infinity) -
        (b.data.startDate?.getTime() ?? Infinity) ||
      a.data.name.localeCompare(b.data.name),
  );
const alumni = members
  .filter((member) => member.data.type === "alumni")
  .sort(
    (a, b) =>
      (b.data.endDate?.getTime() ?? -Infinity) -
        (a.data.endDate?.getTime() ?? -Infinity) ||
      a.data.name.localeCompare(b.data.name),
  );

const supervisors = current.filter((member) => isSupervisor(member.data.role));
const researchers = current.filter((member) => !isSupervisor(member.data.role));

const sections = [
  { id: "members", title: "Current members", members: researchers },
  { id: "alumni", title: "Group alumni", members: alumni },
].filter((section) => section.members.length > 0);
---

<Layout
  title="Group Members"
  description="Meet the people behind our research in intelligent systems and chemical engineering."
>
  <div class="page-grid people-page">
    <section class="people-header">
      <h1>Group Members</h1>
      <p>
        <!-- We are an interdisciplinary research group based at The University of Birmingham and The University of Manchester working at the intersection of chemical engineering, sustainable manufacturing, and artificial intelligence.  -->
        Based at the Universities of Birmingham and Manchester, our interdisciplinary
        team brings together expertise in chemical engineering, sustainable manufacturing
        and artificial intelligence.
      </p>
    </section>

    <FeaturedLead id={supervisors[0].id} member={supervisors[0].data} />

    {
      sections.map((section) => (
        <section
          class="people-section"
          aria-labelledby={`${section.id}-heading`}
        >
          <h2 id={`${section.id}-heading`}>{section.title}</h2>
          <div class="people-list">
            {section.members.map((member) => (
              <MemberCard id={member.id} member={member.data} />
            ))}
          </div>
        </section>
      ))
    }

    {
      members.length === 0 && (
        <section>Member profiles will appear here as they are added.</section>
      )
    }

    <section>
      <h2>Interested in joining?</h2>
      <p>
        Email
        <a href=`mailto:${CONTACT_EMAIL}`>
          {CONTACT_EMAIL}
        </a>.
      </p>
    </section>
  </div>
</Layout>

<style>
  .people-page {
    /* --content-max-width: 960px; */
  }
  section {
    padding-block: 3.5rem;
    /* border-block-end: 1px solid var(--clr-border-strong); */
    scroll-margin-top: var(--research-anchor-offset, 6rem);

    &:last-child {
      border: none;
    }
  }

  .people-header {
    border: none;
    padding-block-end: 2rem;
  }
  h1 {
    /* margin: 0 0 1rem; */
    font-size: var(--fs-title);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }
  .people-header p {
    max-width: 65ch;
    /* color: var(--clr-text-muted); */
    font-size: var(--fs-subheading);
    line-height: 1.6;
    margin-block-start: 0.5rem;
  }
  .people-section {
    padding-block: 1.5rem;

    &:last-child {
      padding-block-end: 3.5rem;
    }
  }
  h2 {
    margin: 0 0 0.75rem;
    font-size: var(--fs-heading);
    font-weight: 600;
  }
  .people-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .people-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.4rem 1.6rem;
    align-items: start;
  }
  @media (max-width: 950px) {
    .people-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 720px) {
    .people-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.8rem 1rem;
    }
    /* .directory-heading { display: block; }
    .member-count { margin-top: .5rem; }
    .filters { gap: 0 1rem; } */
  }
  @media (max-width: 400px) {
    .people-list {
      grid-template-columns: 1fr;
    }
    /* .mobile-break { display: block; } */
  }

  .person {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: 0.5rem 1.5rem;
    align-items: center;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--clr-border-strong);

    &:last-child {
      border: none;
    }
  }
  .person-profile {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
    color: var(--clr-primary-hover);
    font-weight: 600;
    text-decoration: none;
  }
  .portrait {
    display: grid;
    place-items: center;
    --_size: 6rem;
    flex: 0 0 var(--_size);
    width: var(--_size);
    height: var(--_size);
    border-radius: 0.5rem;
    overflow: hidden;
    color: var(--clr-primary-hover);
    background: var(--clr-section-background);
  }
  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .initials {
    color: var(--clr-primary-hover);
    font-size: var(--fs-heading);
  }
  .person-name {
    color: var(--clr-text-body);
    font-size: var(--fs-subheading);
    font-weight: 700;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .person-profile:hover .person-name {
    text-decoration: underline;
  }
  .person-role {
    /* color: var(--clr-text-muted); */
    overflow-wrap: anywhere;
  }
  .person-email {
    color: var(--clr-primary-hover);
  }
  a {
    text-underline-offset: 4px;
  }
  a:focus-visible {
    outline: 2px solid var(--clr-primary-base);
    outline-offset: 4px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 600px) {
    .person {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .person-profile {
      display: flex;
      align-items: center;
      gap: 1rem;
      min-width: 0;
      color: var(--clr-primary-hover);
      text-decoration: none;
    }
    .portrait {
      display: grid;
      place-items: center;
      flex: 0 0 72px;
      width: 72px;
      height: 72px;
      border-radius: 50%;
      overflow: hidden;
      background: var(--clr-card-background);
    }
    .portrait :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .initials {
      color: var(--clr-primary-hover);
      font-size: var(--fs-heading);
    }
    .person-name {
      grid-column: 1;
      grid-row: 1;
    }
    .person-role {
      grid-column: 1;
      grid-row: 2;
      padding-left: calc(72px + 1rem);
    }
    .person-email {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
