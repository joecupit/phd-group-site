---
import Layout from "./Layout.astro";

interface Application {
  title: string;
  description: string;
}

interface Project {
  title: string;
  description: string;
  people?: string;
  href?: string;
}

interface Publication {
  title: string;
  authors: string;
  year: number;
  venue?: string;
  href: string;
}

interface ResearchData {
  title: string;
  subtitle: string;
  summary: string;
  focus?: string[];
  applications?: Application[];
  projects?: Project[];
  publications?: Publication[];
  related?: { title: string; href: string }[];
  contact?: { label: string; href: string };
  researchHref?: string;
}

type Props = ResearchData | { frontmatter: ResearchData };
const page =
  "frontmatter" in Astro.props ? Astro.props.frontmatter : Astro.props;

const {
  title,
  subtitle,
  summary,
  focus = [],
  applications = [],
  projects = [],
  publications = [],
  related = [],
  contact,
  researchHref = "/research/",
} = page;

const hasBody = Astro.slots.has("default");
const hasChallenge = Astro.slots.has("challenge");
const hasApproach = Astro.slots.has("approach");

const sections = [
  ...(hasBody ? [{ id: "overview", label: "Research overview" }] : []),
  ...(hasChallenge ? [{ id: "challenge", label: "The challenge" }] : []),
  ...(hasApproach ? [{ id: "approach", label: "Our approach" }] : []),
  ...(applications.length
    ? [{ id: "applications", label: "Applications" }]
    : []),
  ...(projects.length ? [{ id: "projects", label: "Current projects" }] : []),
  ...(publications.length
    ? [{ id: "publications", label: "Publications" }]
    : []),
];
---

<Layout title={title}>
  <main class="research-page" id="research-content">
    <div class="page-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={researchHref}>Research Areas</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>

      <header class:list={["hero", { "hero--with-focus": focus.length > 0 }]}>
        <div class="hero-copy">
          <!-- <p class="eyebrow"><span aria-hidden="true"></span> Research area</p> -->
          <h1>{title}</h1>
          <p class="subtitle">{subtitle}</p>
          <!-- <p class="summary">{summary}</p> -->
        </div>

        <!-- {
          focus.length > 0 && (
            <aside class="focus-panel" aria-labelledby="focus-heading">
              <svg
                class="focus-pattern"
                viewBox="0 0 240 150"
                aria-hidden="true"
                focusable="false"
              >
                <g fill="none" stroke="currentColor" stroke-width="1">
                  <path d="M12 115 65 40 120 93 174 24 226 75M12 115 120 93 226 75M65 40 174 24M65 40 226 75" />
                  <>
                    <circle cx="12" cy="115" r="4" />
                    <circle cx="65" cy="40" r="4" />
                  </>
                  <>
                    <circle cx="120" cy="93" r="4" />
                    <circle cx="174" cy="24" r="4" />
                  </>
                  <circle cx="226" cy="75" r="4" />
                </g>
              </svg>
              <h2 id="focus-heading">In this area</h2>
              <ul>
                {focus.map((item, index) => (
                  <li>
                    <span aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    {item}
                  </li>
                ))}
              </ul>
            </aside>
          )
        } -->
      </header>

      <!-- {
        sections.length > 0 && (
          <nav class="section-nav" aria-label="On this page">
            {sections.map((section) => (
              <a href={`#${section.id}`}>{section.label}</a>
            ))}
          </nav>
        )
      } -->

      {
        hasBody && (
          <section class="section" id="overview" aria-label="Research overview">
            <div class="prose markdown-copy">
              <p class="summary">{summary}</p>
              <slot />
            </div>
          </section>
        )
      }

      {
        hasChallenge && (
          <section
            class="section section--split"
            id="challenge"
            aria-labelledby="challenge-heading"
          >
            <div class="section-heading">
              <p class="eyebrow">Understanding the problem</p>
              <h2 id="challenge-heading">The challenge</h2>
            </div>
            <div class="prose challenge-copy">
              <slot name="challenge" />
            </div>
          </section>
        )
      }

      {
        hasApproach && (
          <section
            class="section section--split approach-section"
            id="approach"
            aria-labelledby="approach-heading"
          >
            <div class="section-heading">
              <p class="eyebrow">Methods and ideas</p>
              <h2 id="approach-heading">Our approach</h2>
            </div>
            <div class="prose approach-copy">
              <slot name="approach" />
            </div>
          </section>
        )
      }

      {
        applications.length > 0 && (
          <section
            class="section"
            id="applications"
            aria-labelledby="applications-heading"
          >
            <div class="section-heading">
              <p class="eyebrow">Engineering applications</p>
              <h2 id="applications-heading">Where this research is used</h2>
            </div>
            <div class="application-grid">
              {applications.map((application, index) => (
                <article class="application-card">
                  <span class="application-number" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <h3>{application.title}</h3>
                  <p>{application.description}</p>
                </article>
              ))}
            </div>
          </section>
        )
      }

      {
        projects.length > 0 && (
          <section
            class="section"
            id="projects"
            aria-labelledby="projects-heading"
          >
            <div class="section-heading">
              <p class="eyebrow">Work in progress</p>
              <h2 id="projects-heading">Current projects</h2>
            </div>
            <div class="project-grid">
              {projects.map((project) => (
                <article class="project-card">
                  <h3>
                    {project.href ? (
                      <a href={project.href}>
                        {project.title}
                        <span aria-hidden="true"> ↗</span>
                      </a>
                    ) : (
                      project.title
                    )}
                  </h3>
                  <p>{project.description}</p>
                  {project.people && (
                    <p class="project-people">{project.people}</p>
                  )}
                </article>
              ))}
            </div>
          </section>
        )
      }

      {
        publications.length > 0 && (
          <section
            class="section"
            id="publications"
            aria-labelledby="publications-heading"
          >
            <div class="section-heading">
              <p class="eyebrow">Explore the work</p>
              <h2 id="publications-heading">Selected publications</h2>
            </div>
            <ul class="publication-list">
              {publications.map((publication) => (
                <li class="publication">
                  <span class="publication-year">{publication.year}</span>
                  <div class="publication-copy">
                    <h3>
                      <a href={publication.href}>
                        {publication.title}
                        <span aria-hidden="true"> ↗</span>
                      </a>
                    </h3>
                    <p>
                      {publication.authors}
                      {publication.venue && (
                        <>
                          {" "}
                          <span aria-hidden="true">·</span> {publication.venue}
                        </>
                      )}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        (related.length > 0 || contact) && (
          <footer class="research-footer">
            {related.length > 0 && (
              <div>
                <h2>Connected research</h2>
                <ul class="related-list">
                  {related.map((area) => (
                    <li>
                      <a href={area.href}>
                        {area.title}
                        <span aria-hidden="true"> ↗</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {contact && (
              <a class="contact-link" href={contact.href}>
                {contact.label}
                <span aria-hidden="true"> ↗</span>
              </a>
            )}
          </footer>
        )
      }
    </div>
  </main>
</Layout>

<style>
  .research-page {
    /* Change these values to match your site's visual identity. */
    --research-ink: #163330;
    --research-muted: #52645f;
    --research-accent: #1f7062;
    --research-line: #d8e1dc;
    --research-paper: #fbfcf9;
    --research-tint: #edf3ee;
    background: var(--research-paper);
    color: var(--research-ink);
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.65;
    padding: 2.5rem 0 0;
  }

  .research-page,
  .research-page :global(*) {
    box-sizing: border-box;
  }
  .page-inner {
    width: min(72rem, calc(100% - 3rem));
    margin-inline: auto;
  }
  h1,
  h2,
  h3,
  p,
  ul {
    margin: 0;
  }
  h1,
  h2,
  h3 {
    line-height: 1.18;
    text-wrap: balance;
  }
  a {
    color: inherit;
  }
  a:focus-visible {
    outline: 3px solid var(--research-accent);
    outline-offset: 5px;
    border-radius: 2px;
  }
  .research-page :global(img) {
    max-width: 100%;
    height: auto;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: baseline;
    font-size: 0.82rem;
    color: var(--research-muted);
  }
  .breadcrumb a {
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .breadcrumb [aria-current] {
    overflow-wrap: anywhere;
  }
  .hero {
    padding: 3.5rem 0 3rem;
    border-block-end: 1px solid var(--research-line);
  }
  .hero--with-focus {
    /* display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.42fr);
    gap: 4rem;
    align-items: center; */
  }
  .hero-copy {
    min-width: 0;
  }
  .eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--research-accent);
  }
  .hero .eyebrow {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .hero .eyebrow span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
  }
  h1 {
    max-width: 20ch;
    /* font-family: Georgia, "Times New Roman", serif; */
    font-size: clamp(2.5rem, 4.5vw, 4rem);
    /* font-weight: 400; */
    letter-spacing: -0.035em;
  }
  .subtitle {
    max-width: 40ch;
    margin-top: 1.4rem;
    font-size: clamp(1.12rem, 2vw, 1.4rem);
    line-height: 1.45;
  }
  /* .summary {
    max-width: 62ch;
    margin-top: 1.2rem;
    color: var(--research-muted);
  } */

  .focus-panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 2rem 1.6rem;
    background: var(--research-ink);
    color: #f4f8f4;
    border-radius: 0.35rem;
  }
  .focus-pattern {
    position: absolute;
    z-index: -1;
    top: -1rem;
    right: -2.5rem;
    width: 16rem;
    color: #9bd0b9;
    opacity: 0.18;
  }
  .focus-panel h2 {
    margin-bottom: 1.5rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .focus-panel ul {
    list-style: none;
    padding: 0;
  }
  .focus-panel li {
    display: grid;
    grid-template-columns: 1.7rem minmax(0, 1fr);
    gap: 0.6rem;
    padding: 1rem 0;
    border-top: 1px solid #ffffff26;
    line-height: 1.4;
  }
  .focus-panel li:last-child {
    padding-bottom: 0;
  }
  .focus-panel li span {
    color: #acd8c4;
    font-size: 0.72rem;
    padding-top: 0.15rem;
    font-variant-numeric: tabular-nums;
  }

  .section-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.7rem;
    padding: 0.8rem 0;
    border-block: 1px solid var(--research-line);
  }
  .section-nav a {
    padding: 0.45rem 0;
    font-size: 0.85rem;
    text-decoration: none;
    text-underline-offset: 5px;
  }
  .section-nav a:hover {
    color: var(--research-accent);
    text-decoration: underline;
  }
  /* Set --research-anchor-offset on a parent to suit your site's header. */
  .section {
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--research-line);
    scroll-margin-top: var(--research-anchor-offset, 6rem);
  }
  .section--split {
    display: grid;
    grid-template-columns: minmax(0, 0.35fr) minmax(0, 1fr);
    gap: 3.5rem;
  }
  .section-heading .eyebrow {
    margin-bottom: 0.7rem;
  }
  .section-heading h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.025em;
  }
  .prose {
    min-width: 0;
    max-width: 68ch;
  }
  .prose :global(p + p) {
    margin-top: 1rem;
  }
  .prose :global(p) {
    margin: 0;
  }
  .prose :global(h3) {
    margin: 1.7rem 0 0.65rem;
    font-size: 1.12rem;
    line-height: 1.35;
  }
  .prose :global(h3:first-child) {
    margin-top: 0;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 1rem 0;
    padding-inline-start: 1.25rem;
  }
  .prose :global(li + li) {
    margin-top: 0.6rem;
  }
  .prose :global(a) {
    color: var(--research-accent);
    text-underline-offset: 3px;
  }
  .prose :global(a:focus-visible) {
    outline: 3px solid var(--research-accent);
    outline-offset: 4px;
  }
  .prose :global(figure) {
    margin: 1.5rem 0 0;
  }
  .prose :global(figcaption) {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--research-muted);
  }
  /* Markdown headings sit beside their content, using the same section grid. */
  .markdown-copy {
    display: grid;
    grid-template-columns: minmax(0, 0.35fr) minmax(0, 1fr);
    align-items: start;
    gap: 1rem 3.5rem;
    max-width: none;
  }
  .markdown-copy .summary {
    grid-column-start: 1;
    grid-column-end: 3;
  }
  .markdown-copy :global(> *) {
    grid-column: 2;
    min-width: 0;
    max-width: 68ch;
    margin: 0;
  }
  .markdown-copy :global(> h2) {
    grid-column: 1;
    max-width: 18ch;
    margin-top: 2rem;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.025em;
    text-wrap: balance;
    scroll-margin-top: var(--research-anchor-offset, 6rem);
  }
  .markdown-copy :global(> h2:first-child),
  .markdown-copy :global(> h2:first-child + *) {
    margin-top: 0;
  }
  .markdown-copy :global(> p + p) {
    margin-top: 0;
  }
  .markdown-copy :global(> h3) {
    margin: 1rem 0 0;
  }
  .markdown-copy :global(> h2 + *) {
    margin-top: 2rem;
  }
  .markdown-copy :global(> ul),
  .markdown-copy :global(> ol) {
    margin: 0;
  }
  .markdown-copy :global(blockquote) {
    padding-left: 1rem;
    border-left: 3px solid var(--research-accent);
    color: var(--research-muted);
  }
  .markdown-copy :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
  }
  .markdown-copy :global(th),
  .markdown-copy :global(td) {
    padding: 0.6rem;
    border: 1px solid var(--research-line);
    text-align: left;
  }
  .markdown-copy :global(pre) {
    overflow-x: auto;
    padding: 1rem;
    border-radius: 0.35rem;
  }
  .approach-copy {
    padding: 1.7rem 2rem;
    background: var(--research-tint);
    border-left: 3px solid var(--research-accent);
    border-radius: 0 0.35rem 0.35rem 0;
  }

  .application-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.2rem;
    margin-top: 2rem;
  }
  .application-card {
    padding: 1.7rem;
    background: var(--research-tint);
    border-radius: 0.35rem;
  }
  .application-number {
    display: block;
    margin-bottom: 1.5rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 2.1rem;
    line-height: 1;
    color: var(--research-accent);
    opacity: 0.65;
  }
  .application-card h3,
  .project-card h3 {
    font-size: 1.15rem;
    font-weight: 600;
  }
  .application-card p,
  .project-card > p {
    margin-top: 0.8rem;
    color: var(--research-muted);
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 23rem), 1fr));
    gap: 1.5rem 2rem;
    margin-top: 2rem;
  }
  .project-card {
    border-top: 2px solid var(--research-ink);
    padding-top: 1.2rem;
  }
  .project-card a {
    text-decoration: none;
  }
  .project-card a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .project-card > .project-people {
    margin-top: 1.2rem;
    font-size: 0.82rem;
    color: var(--research-ink);
  }

  .publication-list {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
  }
  .publication {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.3rem 0;
    border-top: 1px solid var(--research-line);
  }
  .publication-year {
    padding-top: 0.2rem;
    color: var(--research-accent);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }
  .publication h3 {
    font-size: 1.06rem;
    font-weight: 500;
    line-height: 1.45;
  }
  .publication a {
    text-decoration: none;
  }
  .publication a:hover {
    color: var(--research-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .publication-copy {
    min-width: 0;
  }
  .publication-copy p {
    margin-top: 0.5rem;
    color: var(--research-muted);
    font-size: 0.85rem;
  }
  .research-page :global(p),
  .research-page :global(h3),
  .research-page :global(li) {
    overflow-wrap: anywhere;
  }

  .research-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    padding: 2.5rem 0 3rem;
  }
  .research-footer h2 {
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 0.8rem;
    color: var(--research-muted);
  }
  .related-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    list-style: none;
    padding: 0;
  }
  .related-list a {
    font-size: 0.9rem;
    text-underline-offset: 4px;
  }
  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    padding: 0.8rem 1.1rem;
    border: 1px solid var(--research-ink);
    border-radius: 0.25rem;
    text-decoration: none;
    font-size: 0.9rem;
  }
  .contact-link:hover {
    background: var(--research-ink);
    color: var(--research-paper);
  }

  @media (max-width: 900px) {
    .hero--with-focus {
      gap: 2rem;
      grid-template-columns: minmax(0, 1fr) minmax(14rem, 0.5fr);
    }
    .section--split,
    .markdown-copy {
      gap: 1rem 2rem;
      grid-template-columns: minmax(0, 0.4fr) minmax(0, 1fr);
    }
  }

  @media (max-width: 680px) {
    .research-page {
      padding-top: 1.5rem;
    }
    .page-inner {
      width: calc(100% - 2rem);
    }
    .hero {
      padding: 2.5rem 0 2rem;
    }
    .hero--with-focus,
    .section--split {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
    .focus-panel {
      padding: 1.5rem;
    }
    .section-nav {
      gap: 0.15rem 1.2rem;
    }
    .section {
      padding: 2.5rem 0;
    }
    .approach-copy {
      padding: 1.25rem;
    }
    .markdown-copy {
      display: block;
    }
    .markdown-copy :global(> *) {
      margin-top: 1rem;
    }
    .markdown-copy :global(> h2) {
      max-width: none;
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--research-line);
    }
    .markdown-copy :global(> h2 + *),
    .markdown-copy :global(> p + p) {
      margin-top: 1rem;
    }
    .markdown-copy :global(> h2:first-child) {
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
    }
    .markdown-copy :global(> h2:first-child + *) {
      margin-top: 1rem;
    }
    .markdown-copy :global(> ul),
    .markdown-copy :global(> ol) {
      margin-top: 1rem;
    }
    .publication {
      grid-template-columns: 3rem minmax(0, 1fr);
      gap: 0.75rem;
    }
  }

  @media print {
    .research-page {
      --research-ink: #000;
      --research-muted: #333;
      --research-paper: #fff;
      background: #fff;
    }
    .page-inner {
      width: 100%;
    }
    .hero {
      padding-top: 1rem;
    }
    .section-nav,
    .focus-pattern,
    .contact-link {
      display: none;
    }
    .hero--with-focus,
    .section--split,
    .markdown-copy {
      display: block;
    }
    .focus-panel {
      margin-top: 1rem;
      background: #fff;
      color: #000;
      border: 1px solid #ccc;
    }
    .focus-panel li {
      border-color: #ccc;
    }
    .focus-panel li span {
      color: #333;
    }
    .section {
      padding: 1.5rem 0;
    }
    .section-heading {
      margin-bottom: 1rem;
    }
    .application-card,
    .project-card,
